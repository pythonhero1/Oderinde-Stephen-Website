---
import { getCollection, render } from 'astro:content';
import pageManifest from '../content/pages.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import Insights from '../components/site/Insights.astro';

export async function getStaticPaths() {
  const components = import.meta.glob('../content/pages/*.astro', {
    eager: true,
    import: 'default',
  });
  const styles = import.meta.glob('../styles/pages/*.css', {
    eager: true,
    query: '?url',
    import: 'default',
  });
  const articleTheme = pageManifest.find((page) => page.type === 'collection');
  const published = await getCollection('blog', ({ data }) => !data.draft);
  const posts = await Promise.all(
    published.map(async (entry) => ({
      path: entry.data.slug,
      title: entry.data.title,
      description: entry.data.description,
      updated: entry.data.updated?.toISOString().slice(0, 10),
      type: 'post',
      style: 'article',
      bodyClass: articleTheme.bodyClass,
      Content: (await render(entry)).Content,
    })),
  );
  const pages = [...pageManifest, ...posts];
  if (new Set(pages.map((page) => page.path)).size !== pages.length)
    throw new Error('Each page and post must have a unique address.');
  return pages.map((page) => ({
    params: { path: page.path || undefined },
    props: {
      page,
      posts,
      Component: components[`../content/pages/${page.component}.astro`],
      stylesheet: styles[`../styles/pages/${page.style}.css`],
    },
  }));
}
const { page, posts, Component, stylesheet } = Astro.props;
const Article = page.Content;
---

<SiteLayout page={page} stylesheet={stylesheet} bodyClass={page.bodyClass}>
  {Article ? (
    <article class="site-article">
      <header>
        <p>WEBSITE INSIGHTS</p>
        <h1>{page.title}</h1>
        <p>{page.description}</p>
      </header>
      <Article />
    </article>
  ) : page.type === 'collection' ? (
    <Insights posts={posts} />
  ) : (
    <Component />
  )}
</SiteLayout>
