---
import pages from '../data/wordpress.json';
import contact from '../config/contact.json';
import { renderWordPressPage } from '../lib/wordpress.mjs';
import { getSitePages } from '../lib/site-pages.mjs';
export function getStaticPaths() {
  return getSitePages(pages).map(page => ({
    params: { path: page.path || undefined },
    props: { html: renderWordPressPage(page, contact.verified ? contact.endpoint : '', pages) }
  }));
}
const { html } = Astro.props;
---
<Fragment set:html={html} />
