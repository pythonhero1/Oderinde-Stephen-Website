---
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import Heading from '../../components/content/Heading.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
---

<div class="page-layout page-content">
  <div class="section-stack">
    <PageSection class="section-1 page-section flex-section">
      <Container class="row-1 container flex-row">
        <Column class="column-1 column flex-column blend-normal width-13-24 width-24-24-tablet width-24-24-phone width-13-24-wide-tablet">
          <Heading class="heading-1 block flex-block" level={2}>
            CASE STUDY • WORDPRESS • DIRECT ORDER
          </Heading>
          <Heading class="heading-2 block flex-block" level={1}>
            Bau-Helden — turning a direct order into a{' '}
            <span style="color:#a979ff">structured redesign process.</span>
          </Heading>
          <TextBlock class="copy-1 copy-block tone-light block flex-block">
            <p>
              A three-page German WordPress redesign that began without normal pre-sale discovery,
              moved through visual planning and mobile refinement, and became the design reference
              for the client’s next, larger engagement.
            </p>
          </TextBlock>
          <div class="group-1 block flex-group blend-normal">
            <div class="group-2 block flex-group blend-normal">
              <div class="icon-1 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-3 block flex-block" level={4}>
                Construction
              </Heading>
            </div>
            <div class="group-3 block flex-group blend-normal">
              <div class="icon-2 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-4 block flex-block" level={4}>
                3 core pages
              </Heading>
            </div>
            <div class="group-4 block flex-group blend-normal">
              <div class="icon-3 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-5 block flex-block" level={4}>
                Pre-design first
              </Heading>
            </div>
            <div class="group-5 last-column block flex-group blend-normal">
              <div class="icon-4 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-6 block flex-block" level={4}>
                Repeat client
              </Heading>
            </div>
          </div>
          <div class="group-6 last-column block flex-group blend-normal">
            <ButtonLink
              wrapperClass="block button-wrap button-1-wrapper"
              class="button-1 button tone-light block flex-block"
              target="_blank"
              href="https://bau-helden.de/"
              rel="noopener noreferrer"
            >
              Visit Live Website ↗
            </ButtonLink>
            <ButtonLink
              wrapperClass="block button-wrap button-2-wrapper"
              class="button-2 button tone-light block flex-block"
              href="/case-studies/"
            >
              All Case Studies
            </ButtonLink>
          </div>
        </Column>
        <Column class="column-2 column last-column flex-column blend-normal width-11-24 width-24-24-tablet width-24-24-phone width-11-24-wide-tablet">
          <div class="group-7 last-column block flex-group blend-normal">
            <div class="group-8 block flex-group blend-normal">
              <div class="group-9 block flex-group blend-normal">
                <div class="icon-5 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-6 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-7 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
              <Heading class="heading-7 block flex-block" level={4}>
                bau-helden.de
              </Heading>
            </div>
            <div class="group-10 last-column block flex-group blend-normal">
              <Heading class="heading-8 block flex-block" level={2}>
                REDESIGNED HOMEPAGE
              </Heading>
              <Heading class="heading-9 block flex-block" level={3}>
                PROJECT SCREENSHOT
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  ALT: Bau-Helden WordPress redesign showing the new construction-company homepage
                  and responsive structure.
                </p>
              </TextBlock>
            </div>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-2 page-section flex-section">
      <Container class="row-2 container flex-row">
        <Column class="column-3 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-8 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-10 block flex-block" level={4}>
            ORDER
          </Heading>
          <Heading class="heading-11 block flex-block" level={3}>
            Direct Fiverr order
          </Heading>
        </Column>
        <Column class="column-4 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-9 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-12 block flex-block" level={4}>
            SCOPE
          </Heading>
          <Heading class="heading-13 block flex-block" level={3}>
            3 core pages
          </Heading>
        </Column>
        <Column class="column-5 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-10 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-14 block flex-block" level={4}>
            ASSETS
          </Heading>
          <Heading class="heading-15 block flex-block" level={3}>
            6 Envato items
          </Heading>
        </Column>
        <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-11 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-16 block flex-block" level={4}>
            OUTCOME
          </Heading>
          <Heading class="heading-17 block flex-block" level={3}>
            Repeat client
          </Heading>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-3 page-section flex-section">
      <Container class="row-3 container flex-row">
        <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-18 block flex-block" level={2}>
            FROM THE ARCHIVE CARD
          </Heading>
          <Heading class="heading-19 block flex-block" level={2}>
            The homepage summary, expanded into the full project brief.
          </Heading>
          <TextBlock class="copy-3 copy-block tone-light block flex-block">
            <p>
              The same core information visitors first see on the homepage card is carried into the
              full case study so the transition stays consistent.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-4 container flex-row">
        <Column class="column-8 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-20 block flex-block" level={4}>
            BUSINESS FOCUS
          </Heading>
          <Heading class="heading-21 block flex-block" level={3}>
            Turn a direct order with limited discovery into a clear, credible construction-company
            website.
          </Heading>
          <TextBlock class="copy-4 copy-block tone-light block flex-block">
            <p>
              Create a stronger digital presentation despite WordPress access being unavailable at
              the start, no normal pre-sale discovery conversation, and the need to define visual
              direction before development.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-9 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-22 block flex-block" level={4}>
            SYSTEM DELIVERED
          </Heading>
          <Heading class="heading-23 block flex-block" level={3}>
            A three-page WordPress redesign shaped through pre-design, responsive refinement and
            transparent asset handoff.
          </Heading>
          <TextBlock class="copy-5 copy-block tone-light block flex-block">
            <p>
              Home, Career and Contact pages; pre-design/wireframe before development; responsive
              menu and spacing cleanup; link corrections; and source links for the six Envato
              Elements assets used in the project.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-5 container flex-row">
        <Column class="column-10 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <Heading class="heading-24 block flex-block" level={4}>
            PROJECT TECHNOLOGIES
          </Heading>
          <div class="group-11 block flex-group blend-normal">
            <div class="group-12 block flex-group blend-normal">
              <div class="icon-12 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-25 block flex-block" level={4}>
                WordPress
              </Heading>
            </div>
            <div class="group-13 block flex-group blend-normal">
              <div class="icon-13 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-26 block flex-block" level={4}>
                Responsive UX
              </Heading>
            </div>
            <div class="group-14 last-column block flex-group blend-normal">
              <div class="icon-14 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-27 block flex-block" level={4}>
                Pre-design
              </Heading>
            </div>
          </div>
          <TextBlock class="copy-6 copy-block tone-light block flex-block">
            <p>These mirror the Technology 1–3 fields used by the homepage case-study card.</p>
          </TextBlock>
        </Column>
        <Column class="column-11 column last-column flex-column blend-normal width-14-24 width-24-24-tablet width-24-24-phone width-14-24-wide-tablet">
          <Heading class="heading-28 block flex-block" level={4}>
            VERIFIED OUTCOME
          </Heading>
          <Heading class="heading-29 block flex-block" level={3}>
            REPEAT CLIENT OUTCOME
          </Heading>
          <TextBlock class="copy-7 copy-block tone-light block flex-block">
            <p>
              The strongest proof is retention. The same buyer later returned with a larger website
              and explicitly said:{' '}
              <strong style="color:#f5f7fc">
                “I’d like a similar style to Bau-Helden — you built that as well.”
              </strong>
            </p>
          </TextBlock>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-4 page-section flex-section">
      <Container class="row-6 container flex-row">
        <Column class="column-12 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-30 block flex-block" level={2}>
            THE STARTING POINT
          </Heading>
          <Heading class="heading-31 block flex-block" level={2}>
            The order arrived before the project had a complete design direction.
          </Heading>
          <TextBlock class="copy-8 copy-block tone-light block flex-block">
            <p>
              Instead of jumping straight into WordPress, the project needed a short recovery and
              planning sequence first.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-7 container flex-row">
        <Column class="column-13 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-15 block flex-group blend-normal">
            <Heading class="heading-32 block flex-block" level={4}>
              01
            </Heading>
            <div class="icon-15 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <Heading class="heading-33 block flex-block" level={4}>
            DIRECT ORDER
          </Heading>
          <TextBlock class="copy-9 copy-block tone-light block flex-block">
            <p>Client committed before normal discovery.</p>
          </TextBlock>
        </Column>
        <Column class="column-14 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-16 block flex-group blend-normal">
            <Heading class="heading-34 block flex-block" level={4}>
              02
            </Heading>
            <div class="icon-16 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <Heading class="heading-35 block flex-block" level={4}>
            ACCESS ISSUE
          </Heading>
          <TextBlock class="copy-10 copy-block tone-light block flex-block">
            <p>WordPress admin was unavailable initially.</p>
          </TextBlock>
        </Column>
        <Column class="column-15 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-17 block flex-group blend-normal">
            <Heading class="heading-36 block flex-block" level={4}>
              03
            </Heading>
            <div class="icon-17 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <Heading class="heading-37 block flex-block" level={4}>
            PRE-DESIGN
          </Heading>
          <TextBlock class="copy-11 copy-block tone-light block flex-block">
            <p>Visual structure created before development.</p>
          </TextBlock>
        </Column>
        <Column class="column-16 column last-column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-18 block flex-group blend-normal">
            <Heading class="heading-38 block flex-block" level={4}>
              04
            </Heading>
            <div class="icon-18 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <Heading class="heading-39 block flex-block" level={4}>
            BUILD
          </Heading>
          <TextBlock class="copy-12 copy-block tone-light block flex-block">
            <p>Three pages implemented and refined.</p>
          </TextBlock>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-5 page-section flex-section">
      <Container class="row-8 container flex-row">
        <Column class="column-17 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-40 block flex-block" level={2}>
            SITE ARCHITECTURE
          </Heading>
          <Heading class="heading-41 block flex-block" level={2}>
            Three pages, three different business jobs.
          </Heading>
          <TextBlock class="copy-13 copy-block tone-light block flex-block">
            <p>
              The project stayed intentionally compact. Each page had a clear role instead of adding
              unnecessary content.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-9 container flex-row">
        <Column class="column-18 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="icon-19 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-42 block flex-block" level={4}>
            HOME
          </Heading>
          <Heading class="heading-43 block flex-block" level={3}>
            Credibility + services
          </Heading>
          <TextBlock class="copy-14 copy-block tone-light block flex-block">
            <p>
              Introduce the company, establish visual trust and route visitors to the right next
              step.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-19 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="icon-20 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-44 block flex-block" level={4}>
            CAREER
          </Heading>
          <Heading class="heading-45 block flex-block" level={3}>
            Recruitment path
          </Heading>
          <TextBlock class="copy-15 copy-block tone-light block flex-block">
            <p>
              Give potential applicants a dedicated route without cluttering the commercial
              homepage.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-20 column last-column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="icon-21 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-46 block flex-block" level={4}>
            CONTACT
          </Heading>
          <Heading class="heading-47 block flex-block" level={3}>
            Enquiry path
          </Heading>
          <TextBlock class="copy-16 copy-block tone-light block flex-block">
            <p>Make it straightforward for prospects to reach the business.</p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-10 container flex-row">
        <Column class="column-21 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <div class="group-19 last-column block flex-group blend-normal">
            <div class="group-20 block flex-group blend-normal">
              <div class="icon-22 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-48 block flex-block" level={4}>
                Mobile navigation
              </Heading>
            </div>
            <div class="group-21 block flex-group blend-normal">
              <div class="icon-23 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-49 block flex-block" level={4}>
                Spacing cleanup
              </Heading>
            </div>
            <div class="group-22 block flex-group blend-normal">
              <div class="icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-50 block flex-block" level={4}>
                Link corrections
              </Heading>
            </div>
            <div class="group-23 last-column block flex-group blend-normal">
              <div class="icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-51 block flex-block" level={4}>
                Asset handoff
              </Heading>
            </div>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-6 page-section flex-section">
      <Container class="row-11 container flex-row">
        <Column class="column-22 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-52 block flex-block" level={2}>
            PRE-DESIGN FIRST
          </Heading>
          <Heading class="heading-53 block flex-block" level={2}>
            A short design step prevented the direct order from becoming a blind build.
          </Heading>
          <TextBlock class="copy-17 copy-block tone-light block flex-block">
            <p>
              The wireframe/pre-design stage established the visual direction before WordPress
              implementation, making later refinement much more controlled.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-12 container flex-row">
        <Column class="column-23 column flex-column blend-normal width-9-24 width-24-24-tablet width-24-24-phone width-9-24-wide-tablet">
          <Heading class="heading-54 block flex-block" level={4}>
            WITHOUT PRE-DESIGN
          </Heading>
          <div class="group-24 block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-18 copy-block tone-light block flex-block">
              <p>More interpretation during build</p>
            </TextBlock>
          </div>
          <div class="group-25 block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-19 copy-block tone-light block flex-block">
              <p>Higher chance of rework</p>
            </TextBlock>
          </div>
          <div class="group-26 last-column block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-20 copy-block tone-light block flex-block">
              <p>Harder mobile decisions</p>
            </TextBlock>
          </div>
        </Column>
        <Column class="column-24 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-27 last-column block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <Heading class="heading-55 block flex-block" level={4}>
              WIREFRAME
            </Heading>
          </div>
        </Column>
        <Column class="column-25 column last-column flex-column blend-normal width-9-24 width-24-24-tablet width-24-24-phone width-9-24-wide-tablet">
          <Heading class="heading-56 block flex-block" level={4}>
            WITH PRE-DESIGN
          </Heading>
          <div class="group-28 block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-21 copy-block tone-light block flex-block">
              <p>Clear visual direction</p>
            </TextBlock>
          </div>
          <div class="group-29 block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-22 copy-block tone-light block flex-block">
              <p>Controlled implementation</p>
            </TextBlock>
          </div>
          <div class="group-30 last-column block flex-group blend-normal">
            <div class="icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-23 copy-block tone-light block flex-block">
              <p>Better responsive refinement</p>
            </TextBlock>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-7 page-section flex-section">
      <Container class="row-13 container flex-row">
        <Column class="column-26 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-57 block flex-block" level={2}>
            VISUAL EVIDENCE
          </Heading>
          <Heading class="heading-58 block flex-block" level={2}>
            The finished pages should carry the proof.
          </Heading>
          <TextBlock class="copy-24 copy-block tone-light block flex-block">
            <p>
              Use the large frame for the homepage and the supporting cards for mobile, Career and
              Contact.
            </p>
          </TextBlock>
