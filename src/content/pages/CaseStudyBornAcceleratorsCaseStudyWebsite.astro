---
import site from '../../config/site.json';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import Heading from '../../components/content/Heading.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
---

<div class="page-layout page-content">
  <div class="section-stack">
    <PageSection class="section-1 page-section flex-section">
      <Container class="row-1 container flex-row">
        <Column class="column-1 column flex-column blend-normal width-13-24 width-24-24-tablet width-24-24-phone width-13-24-wide-tablet">
          <Heading class="heading-1 block flex-block" level={2}>
            CASE STUDY • WORDPRESS • BILINGUAL
          </Heading>
          <Heading class="heading-2 block flex-block" level={1}>
            BORN Accelerators — building a bilingual launch platform around a{' '}
            <span style="color:#2563eb">moving campaign.</span>
          </Heading>
          <TextBlock class="copy-1 copy-block tone-light block flex-block">
            <p>
              A Sport, Health &amp; Tech accelerator website built to explain a new ecosystem,
              support German and English audiences, route startups and investors toward the right
              action, and still launch while campaign priorities were changing.
            </p>
          </TextBlock>
          <div class="group-1 block flex-group blend-normal">
            <div class="group-2 block flex-group blend-normal">
              <div class="icon-1 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-3 block flex-block" level={4}>
                WordPress + Elementor
              </Heading>
            </div>
            <div class="group-3 block flex-group blend-normal">
              <div class="icon-2 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-4 block flex-block" level={4}>
                German + English
              </Heading>
            </div>
            <div class="group-4 block flex-group blend-normal">
              <div class="icon-3 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-5 block flex-block" level={4}>
                ISPO launch
              </Heading>
            </div>
            <div class="group-5 last-column block flex-group blend-normal">
              <div class="icon-4 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-6 block flex-block" level={4}>
                Design · Build · Migration
              </Heading>
            </div>
          </div>
          <div class="group-6 last-column block flex-group blend-normal">
            <ButtonLink
              wrapperClass="block button-wrap button-1-wrapper"
              class="button-1 button tone-light block flex-block"
              target="_blank"
              href="https://bornaccelerators.com/"
              rel="noopener noreferrer"
            >
              Visit Live Website ↗
            </ButtonLink>
            <ButtonLink
              wrapperClass="block button-wrap button-2-wrapper"
              class="button-2 button tone-light block flex-block"
              href="/case-studies/"
            >
              All Case Studies
            </ButtonLink>
          </div>
        </Column>
        <Column class="column-2 column last-column flex-column blend-normal width-11-24 width-24-24-tablet width-24-24-phone width-11-24-wide-tablet">
          <div class="group-7 block flex-group blend-normal">
            <div class="group-8 block flex-group blend-normal">
              <div class="icon-5 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <div class="icon-6 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <div class="icon-7 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
            </div>
            <Heading class="heading-7 block flex-block" level={4}>
              bornaccelerators.com
            </Heading>
          </div>
          <div class="group-9 last-column block flex-group blend-normal"></div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-2 page-section flex-section">
      <Container class="row-2 container flex-row">
        <Column class="column-3 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-8 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-8 block flex-block" level={4}>
            CLIENT
          </Heading>
          <Heading class="heading-9 block flex-block" level={3}>
            BORN Accelerators
          </Heading>
        </Column>
        <Column class="column-4 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-9 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-10 block flex-block" level={4}>
            INDUSTRY
          </Heading>
          <Heading class="heading-11 block flex-block" level={3}>
            Sport · Health · Tech
          </Heading>
        </Column>
        <Column class="column-5 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-10 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-12 block flex-block" level={4}>
            ENGAGEMENT
          </Heading>
          <Heading class="heading-13 block flex-block" level={3}>
            Design · Build · Migration
          </Heading>
        </Column>
        <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-11 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-14 block flex-block" level={4}>
            VERIFIED
          </Heading>
          <Heading class="heading-15 block flex-block" level={3}>
            4.7/5 client review
          </Heading>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-3 page-section flex-section">
      <Container class="row-3 container flex-row">
        <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-16 block flex-block" level={4}>
            FROM THE ARCHIVE CARD
          </Heading>
          <Heading class="heading-17 block flex-block" level={2}>
            The short card summary, expanded into the full project brief.
          </Heading>
          <TextBlock class="copy-2 copy-block tone-light block flex-block">
            <p>
              These are the same core details visitors first meet on the homepage case-study card,
              carried into the full project page so the story remains consistent.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-4 container flex-row">
        <Column class="column-8 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-18 block flex-block" level={4}>
            BUSINESS FOCUS
          </Heading>
          <Heading class="heading-19 block flex-block" level={3}>
            Launch a credible bilingual accelerator platform without waiting for every campaign
            detail to stop changing.
          </Heading>
          <TextBlock class="copy-3 copy-block tone-light block flex-block">
            <p>
              Clarify BORN’s offer, support the ISPO campaign, guide startups and investors toward
              different actions, and keep the structure flexible enough to absorb evolving content
              and priorities.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-9 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-20 block flex-block" level={4}>
            SYSTEM DELIVERED
          </Heading>
          <Heading class="heading-21 block flex-block" level={3}>
            A bilingual WordPress + Elementor system connecting content, conversion, proof and
            launch operations.
          </Heading>
          <TextBlock class="copy-4 copy-block tone-light block flex-block">
            <p>
              DE/EN architecture, startup and investor conversion routes, reusable ecosystem
              sections for partners, athletes and hubs, application routing, migration to production
              and final stabilization.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-5 container flex-row">
        <Column class="column-10 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <Heading class="heading-22 block flex-block" level={4}>
            PROJECT TECHNOLOGIES
          </Heading>
          <div class="group-10 block flex-group blend-normal">
            <div class="group-11 block flex-group blend-normal">
              <div class="icon-12 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-23 block flex-block" level={4}>
                WordPress
              </Heading>
            </div>
            <div class="group-12 block flex-group blend-normal">
              <div class="icon-13 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-24 block flex-block" level={4}>
                Elementor
              </Heading>
            </div>
            <div class="group-13 last-column block flex-group blend-normal">
              <div class="icon-14 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-25 block flex-block" level={4}>
                Bilingual UX
              </Heading>
            </div>
          </div>
          <TextBlock class="copy-5 copy-block tone-light block flex-block">
            <p>These mirror Technology 1–3 from the Case Study meta fields.</p>
          </TextBlock>
        </Column>
        <Column class="column-11 column last-column flex-column blend-normal width-14-24 width-24-24-tablet width-24-24-phone width-14-24-wide-tablet">
          <Heading class="heading-26 block flex-block" level={4}>
            VERIFIED OUTCOME
          </Heading>
          <Heading class="heading-27 block flex-block" level={3}>
            4.7 / 5 CLIENT REVIEW
          </Heading>
          <TextBlock class="copy-6 copy-block tone-light block flex-block">
            <p>
              The Fiverr review recorded <strong style="color:#f5f7fc">5/5 Quality</strong>,{' '}
              <strong style="color:#f5f7fc">5/5 Value</strong> and{' '}
              <strong style="color:#f5f7fc">4/5 Communication</strong>. The client described the
              finished result as stable and solid after a complex bilingual launch.
            </p>
          </TextBlock>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-4 page-section flex-section">
      <Container class="row-6 container flex-row">
        <Column class="column-12 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <Heading class="heading-28 block flex-block" level={2}>
            THE CHALLENGE
          </Heading>
          <Heading class="heading-29 block flex-block" level={2}>
            Build for a fixed launch date while the brief was still moving.
          </Heading>
          <TextBlock class="copy-7 copy-block tone-light block flex-block">
            <p>
              BORN’s website could not wait for every campaign detail to settle. The project needed
              enough structure to move forward while still being flexible enough to absorb new
              priorities, bilingual content and multiple audience journeys.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-13 column last-column flex-column blend-normal width-14-24 width-24-24-tablet width-24-24-phone width-14-24-wide-tablet">
          <div class="group-14 block flex-group blend-normal">
            <Heading class="heading-30 block flex-block" level={3}>
              ISPO LAUNCH
            </Heading>
            <TextBlock class="copy-8 copy-block tone-light block flex-block">
              <p>One fixed commercial moment. Four moving pressures.</p>
            </TextBlock>
          </div>
          <Container class="row-7 container layout-row-nested flex-row">
            <Column class="column-14 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <Heading class="heading-31 block flex-block" level={4}>
                CONTENT
              </Heading>
              <TextBlock class="copy-9 copy-block tone-light block flex-block">
                <p>Arriving in evolving batches</p>
              </TextBlock>
            </Column>
            <Column class="column-15 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <Heading class="heading-32 block flex-block" level={4}>
                LANGUAGE
              </Heading>
              <TextBlock class="copy-10 copy-block tone-light block flex-block">
                <p>German + English</p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-8 container layout-row-nested flex-row">
            <Column class="column-16 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <Heading class="heading-33 block flex-block" level={4}>
                AUDIENCE
              </Heading>
              <TextBlock class="copy-11 copy-block tone-light block flex-block">
                <p>Startups + investors</p>
              </TextBlock>
            </Column>
            <Column class="column-17 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <Heading class="heading-34 block flex-block" level={4}>
                INFRASTRUCTURE
              </Heading>
              <TextBlock class="copy-12 copy-block tone-light block flex-block">
                <p>Hosting + migration</p>
              </TextBlock>
            </Column>
          </Container>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-5 page-section flex-section">
      <Container class="row-9 container flex-row">
        <Column class="column-18 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-35 block flex-block" level={2}>
            THE PROJECT JOURNEY
          </Heading>
          <Heading class="heading-36 block flex-block" level={2}>
            Five moves that kept the launch from becoming chaos.
          </Heading>
          <TextBlock class="copy-13 copy-block tone-light block flex-block">
            <p>
              Instead of a simple stacked timeline, the journey now reads like a sequence of
              decisions—each stage changes the direction of the project.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-10 container flex-row">
        <Column class="column-19 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-15 last-column block flex-group blend-normal">
            <Heading class="heading-37 block flex-block" level={4}>
              DIRECTION
            </Heading>
            <Heading class="heading-38 block flex-block" level={3}>
              Create the visual and information system before development began.
            </Heading>
            <div class="group-16 last-column block flex-group blend-normal">
              <div class="icon-15 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <TextBlock class="copy-14 copy-block tone-light block flex-block">
                <p>Strategy locked</p>
              </TextBlock>
            </div>
          </div>
        </Column>
        <Column class="column-20 column flex-column blend-normal width-4-24 width-24-24-tablet width-24-24-phone width-4-24-wide-tablet">
          <div class="group-17 block flex-group blend-normal">
            <Heading class="heading-39 block flex-block" level={3}>
              01
            </Heading>
          </div>
          <div class="group-18 last-column block flex-group blend-normal">
            <div class="copy-15 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-21 column last-column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-19 last-column block flex-group blend-normal">
            <div class="copy-16 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
      </Container>
      <Container class="row-11 container flex-row">
        <Column class="column-22 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-20 last-column block flex-group blend-normal">
            <div class="copy-17 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-23 column flex-column blend-normal width-4-24 width-24-24-tablet width-24-24-phone width-4-24-wide-tablet">
          <div class="group-21 block flex-group blend-normal">
            <Heading class="heading-40 block flex-block" level={3}>
              02
            </Heading>
          </div>
          <div class="group-22 last-column block flex-group blend-normal">
            <div class="copy-18 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-24 column last-column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-23 last-column block flex-group blend-normal">
            <Heading class="heading-41 block flex-block" level={4}>
              BUILD
            </Heading>
            <Heading class="heading-42 block flex-block" level={3}>
              Translate the approved direction into reusable WordPress sections.
            </Heading>
            <div class="group-24 last-column block flex-group blend-normal">
              <div class="icon-16 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <TextBlock class="copy-19 copy-block tone-light block flex-block">
                <p>Core system built</p>
              </TextBlock>
            </div>
          </div>
        </Column>
      </Container>
      <Container class="row-12 container flex-row">
        <Column class="column-25 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-25 last-column block flex-group blend-normal">
            <Heading class="heading-43 block flex-block" level={4}>
              CAMPAIGN SHIFT
            </Heading>
            <Heading class="heading-44 block flex-block" level={3}>
              Reposition the entry experience when startup applications became the priority.
            </Heading>
            <div class="group-26 last-column block flex-group blend-normal">
              <div class="icon-17 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <TextBlock class="copy-20 copy-block tone-light block flex-block">
                <p>Homepage pivot</p>
              </TextBlock>
            </div>
          </div>
        </Column>
        <Column class="column-26 column flex-column blend-normal width-4-24 width-24-24-tablet width-24-24-phone width-4-24-wide-tablet">
          <div class="group-27 block flex-group blend-normal">
            <Heading class="heading-45 block flex-block" level={3}>
              03
            </Heading>
          </div>
          <div class="group-28 last-column block flex-group blend-normal">
            <div class="copy-21 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-27 column last-column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-29 last-column block flex-group blend-normal">
            <div class="copy-22 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
      </Container>
      <Container class="row-13 container flex-row">
        <Column class="column-28 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-30 last-column block flex-group blend-normal">
            <div class="copy-23 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-29 column flex-column blend-normal width-4-24 width-24-24-tablet width-24-24-phone width-4-24-wide-tablet">
          <div class="group-31 block flex-group blend-normal">
            <Heading class="heading-46 block flex-block" level={3}>
              04
            </Heading>
          </div>
          <div class="group-32 last-column block flex-group blend-normal">
            <div class="copy-24 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
        <Column class="column-30 column last-column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-33 last-column block flex-group blend-normal">
            <Heading class="heading-47 block flex-block" level={4}>
              MIGRATION
            </Heading>
            <Heading class="heading-48 block flex-block" level={3}>
              Move review work into the production environment without losing control.
            </Heading>
            <div class="group-34 last-column block flex-group blend-normal">
              <div class="icon-18 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <TextBlock class="copy-25 copy-block tone-light block flex-block">
                <p>Production move</p>
              </TextBlock>
            </div>
          </div>
        </Column>
      </Container>
      <Container class="row-14 container flex-row">
        <Column class="column-31 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-35 last-column block flex-group blend-normal">
            <Heading class="heading-49 block flex-block" level={4}>
              STABILISE
            </Heading>
            <Heading class="heading-50 block flex-block" level={3}>
              Resolve final live issues and leave a solid base for future growth.
            </Heading>
            <div class="group-36 last-column block flex-group blend-normal">
              <div class="icon-19 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <TextBlock class="copy-26 copy-block tone-light block flex-block">
                <p>Launch secured</p>
              </TextBlock>
            </div>
          </div>
        </Column>
        <Column class="column-32 column flex-column blend-normal width-4-24 width-24-24-tablet width-24-24-phone width-4-24-wide-tablet">
          <div class="group-37 last-column block flex-group blend-normal">
            <Heading class="heading-51 block flex-block" level={3}>
              05
            </Heading>
          </div>
        </Column>
        <Column class="column-33 column last-column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <div class="group-38 last-column block flex-group blend-normal">
            <div class="copy-27 copy-block tone-light block flex-block"></div>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-6 page-section flex-section">
      <Container class="row-15 container flex-row">
        <Column class="column-34 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-52 block flex-block" level={2}>
            SOLUTION ARCHITECTURE
          </Heading>
          <Heading class="heading-53 block flex-block" level={2}>
            One website core. Four business jobs around it.
          </Heading>
          <TextBlock class="copy-28 copy-block tone-light block flex-block">
            <p>
              This section now behaves like an architecture diagram instead of a four-card service
              grid.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-16 container flex-row">
        <Column class="column-35 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-39 block flex-group blend-normal">
            <div class="group-40 block flex-group blend-normal">
              <Heading class="heading-54 block flex-block" level={4}>
                POSITION
              </Heading>
              <div class="icon-20 icon-block block flex-block">
