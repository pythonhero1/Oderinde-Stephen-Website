---
import site from '../../config/site.json';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
import ImageBlock from '../../components/content/ImageBlock.astro';
import ResponsiveImage from '../../components/content/ResponsiveImage.astro';
import Accordion from '../../components/content/Accordion.astro';
---

<article id="page-entry">
  <div class="entry-content">
    <div class="page-layout page-content">
      <div class="section-stack">
        <PageSection class="section-1 page-section flex-section">
          <Container class="row-1 container flex-row">
            <Column class="column-1 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet os-hero-copy">
              <TextBlock class="copy-1 copy-block tone-light block flex-block">
                <p>WEBSITES • E-COMMERCE • AUTOMATION</p>
              </TextBlock>
              <Heading class="heading-1 block flex-block" level={1}>
                I build digital systems that help businesses{' '}
                <span style="color: #2563EB">attract customers</span>,{' '}
                <span style="color: #2563EB">sell </span> and{' '}
                <span style="color: #2563EB">grow.</span>
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  From high performing websites and e-commerce platforms to automation and business
                  integrations, I build connected systems that solve operational problems and turn
                  your digital presence into a working business asset.
                </p>
              </TextBlock>
              <Container class="row-2 container layout-row-nested flex-row">
                <Column class="column-2 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <ButtonLink
                    wrapperClass="block button-wrap button-1-wrapper"
                    class="button-1 button tone-light block flex-block"
                    href="/case-studies/"
                  >
                    Explore My Work
                  </ButtonLink>
                  <ButtonLink
                    wrapperClass="block button-wrap button-2-wrapper"
                    class="button-2 button tone-light block flex-block"
                    target="_blank"
                    href={site.booking}
                    rel="noopener noreferrer"
                  >
                    Book a Strategy Call
                  </ButtonLink>
                </Column>
              </Container>
            </Column>
            <Column class="column-3 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet os-hero-visual">
              <ImageBlock class="image-1 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="Oderinde-Stephen-human-picture-with-google-wix-shopify-website-logo.avif"
                    alt="Oderinde Stephen presenting WordPress, Shopify and Website Development &amp; Digital Solutions"
                    title="Oderinde Stephen human picture with google, wix, shopify, wordpress logo"
                    width="2048"
                    height="1536"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    priority
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-3 container flex-row">
            <Column class="column-4 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-3 copy-block tone-light block flex-block">
                <p>RATED ON</p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-4 container flex-row">
            <Column class="column-5 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-1 last-column block flex-group blend-normal os-motion-lift">
                <ImageBlock class="image-2 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="g2-review-platform-icon.png"
                      title="g2 review platform icon"
                      width="1254"
                      height="1254"
                      sizes="96px"
                    />
                  </span>
                </ImageBlock>
                <div class="group-2 last-column block flex-group blend-normal">
                  <Heading class="heading-2 block flex-block" level={3}>
