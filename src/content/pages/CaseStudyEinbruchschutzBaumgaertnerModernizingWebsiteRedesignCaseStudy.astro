---
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import Heading from '../../components/content/Heading.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
---

<div class="page-layout page-content">
  <div class="section-stack">
    <PageSection class="section-1 page-section flex-section">
      <Container class="row-1 container flex-row">
        <Column class="column-1 column flex-column blend-normal width-13-24 width-24-24-tablet width-24-24-phone width-13-24-wide-tablet">
          <Heading class="heading-1 block flex-block" level={2}>
            CASE STUDY • REPEAT CLIENT • SEO
          </Heading>
          <Heading class="heading-2 block flex-block" level={1}>
            Einbruchschutz Baumgaertner — modernizing an 11-page security site while{' '}
            <span style="color:#d84b4b">protecting what already worked.</span>
          </Heading>
          <TextBlock class="copy-1 copy-block tone-light block flex-block">
            <p>
              A larger repeat-client WordPress engagement covering visual redesign, responsive
              rebuilding, on-page SEO, video, manufacturer proof, Google reviews, staging and
              production migration for a German security business.
            </p>
          </TextBlock>
          <div class="group-1 block flex-group blend-normal">
            <div class="group-2 block flex-group blend-normal">
              <div class="icon-1 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-3 block flex-block" level={4}>
                11-page redesign
              </Heading>
            </div>
            <div class="group-3 block flex-group blend-normal">
              <div class="icon-2 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-4 block flex-block" level={4}>
                Repeat client
              </Heading>
            </div>
            <div class="group-4 block flex-group blend-normal">
              <div class="icon-3 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-5 block flex-block" level={4}>
                SEO + responsive
              </Heading>
            </div>
            <div class="group-5 last-column block flex-group blend-normal">
              <div class="icon-4 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-6 block flex-block" level={4}>
                Trustindex reviews
              </Heading>
            </div>
          </div>
          <div class="group-6 last-column block flex-group blend-normal">
            <ButtonLink
              wrapperClass="block button-wrap button-1-wrapper"
              class="button-1 button tone-light block flex-block"
              target="_blank"
              href="https://einbruchschutz-baumgaertner.de/"
              rel="noopener noreferrer"
            >
              Visit Live Website ↗
            </ButtonLink>
            <ButtonLink
              wrapperClass="block button-wrap button-2-wrapper"
              class="button-2 button tone-light block flex-block"
              href="/case-studies/"
            >
              All Case Studies
            </ButtonLink>
          </div>
        </Column>
        <Column class="column-2 column last-column flex-column blend-normal width-11-24 width-24-24-tablet width-24-24-phone width-11-24-wide-tablet">
          <div class="group-7 last-column block flex-group blend-normal">
            <div class="group-8 block flex-group blend-normal">
              <div class="group-9 block flex-group blend-normal">
                <div class="icon-5 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-6 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-7 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
