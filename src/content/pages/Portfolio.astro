---

<article id="page-entry" class="portfolio-page">
  <section class="portfolio-hero">
    <div class="portfolio-hero-inner">
      <div class="portfolio-hero-copy">
        <p class="portfolio-eyebrow">SELECTED WEBSITE PORTFOLIO</p>
        <h1>
          Websites Built for <span>Real Businesses, Brands &amp; Ideas.</span>
        </h1>
        <p class="portfolio-intro">
          Explore a broad selection of business websites, e-commerce stores, professional service
          platforms and international projects delivered across different industries.
        </p>
        <div class="portfolio-hero-actions">
          <a class="portfolio-primary-button" href="#portfolio-library">
            Explore Portfolio
          </a>
          <a class="portfolio-secondary-button" href="/case-studies/">
            View Case Studies
          </a>
        </div>
        <p class="portfolio-count-label">REAL PROJECT STORIES</p>
        <div class="portfolio-count" aria-label="52 plus selected website projects">
          <strong data-portfolio-counter data-target="52" aria-label="52 plus">
            52+
          </strong>
          <span>selected website projects across business and e-commerce</span>
        </div>
      </div>
      <div class="portfolio-hero-media">
        <ResponsiveImage
          source="case-study-on-blue-and-red-background-scaled.avif"
          alt="Case study signs presented on a vivid red and blue background"
          width="2560"
          height="1920"
          sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
          priority
        />
      </div>
    </div>
    <div class="portfolio-benefits" aria-label="Portfolio strengths">
      <span>Business-first design</span>
      <span>Responsive development</span>
      <span>Platform-flexible builds</span>
      <span>International project experience</span>
    </div>
  </section>

  <section class="portfolio-library" id="portfolio-library">
    <div class="portfolio-section-heading">
      <p>THE PORTFOLIO LIBRARY</p>
      <h2>
        Explore <span>Selected Website Projects.</span>
      </h2>
      <p>
        Filter the collection by project type, open a larger on-page preview, or visit any live
        website in a new tab.
      </p>
    </div>

    <div class="portfolio-filters" role="group" aria-label="Filter portfolio projects">
      {categories.map((category, index) => (
        <button
          type="button"
          class:list={['portfolio-filter', { 'is-active': index === 0 }]}
          data-portfolio-filter={category === 'All projects' ? 'all' : category}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {category}
        </button>
      ))}
    </div>

    <div class="portfolio-grid" data-portfolio-grid>
      {portfolioProjects.map((project, index) => {
        const image = project.thumbnail ?? screenshotUrl(project.url);
        const domain = new URL(project.url).hostname.replace(/^www\./, '');
        return (
          <article class="portfolio-card" data-project-category={project.category}>
            <span class="portfolio-card-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="portfolio-browser-window">
              <div class="portfolio-browser-bar" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <small>{domain}</small>
              </div>
              <img
                src={image}
                alt={`${project.title} website homepage preview`}
                width="1200"
                height="675"
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </div>
            <div class="portfolio-card-copy">
              <p>
                {project.category} · {project.industry}
              </p>
              <h3>{project.title}</h3>
            </div>
            <button
              class="portfolio-preview-trigger"
              type="button"
              data-preview-url={project.url}
              data-preview-title={project.title}
              data-preview-image={image}
            >
              <span>Preview website</span>
              <span aria-hidden="true">↗</span>
            </button>
          </article>
        );
      })}
    </div>
    <p class="portfolio-empty" data-portfolio-empty hidden>
      No projects match this filter.
    </p>
  </section>

  <section class="portfolio-cta">
    <div class="portfolio-cta-panel">
      <p class="portfolio-cta-label">READY TO DISCUSS YOUR NEXT PROJECT?</p>
      <h2>
        Let’s Turn Your <span>Project Goals</span> Into a Practical Solution.
      </h2>
      <p class="portfolio-cta-copy">
        Seen a project that reflects your business goals? Whether you're planning a professional
        website, an e-commerce store or a custom digital solution, let's discuss your requirements
        and explore the right approach for your business.
      </p>
      <div class="portfolio-cta-actions">
        <a class="portfolio-primary-button" href="/contact/">
          Start Your Project
        </a>
        <a
          class="portfolio-secondary-button"
          href={site.booking}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a Strategy Call
        </a>
      </div>
      <p class="portfolio-cta-links">
        Explore more: <a href="/">Homepage</a> ·{' '}
        <a href="/business-website-solutions/">Business Website Solutions</a> ·{' '}
        <a href="/case-studies/">Case Studies</a> · <a href="/portfolio/">Portfolio</a>
      </p>
    </div>
  </section>

  <div class="portfolio-preview-modal" data-portfolio-modal hidden>
    <button
      class="portfolio-preview-backdrop"
      type="button"
      data-preview-close
      aria-label="Close website preview"
    ></button>
    <section
      class="portfolio-preview-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="portfolio-preview-title"
    >
      <header class="portfolio-preview-toolbar">
        <div>
          <span>WEBSITE PREVIEW</span>
          <h3 id="portfolio-preview-title">Website preview</h3>
        </div>
        <div class="portfolio-preview-actions">
          <button
            type="button"
            class="portfolio-preview-mode"
            data-preview-mode-toggle
            aria-pressed="false"
          >
            Image preview
          </button>
          <a class="portfolio-preview-live-link" href="#" target="_blank" rel="noopener noreferrer">
            Open live website <span aria-hidden="true">↗</span>
          </a>
          <button
            type="button"
            class="portfolio-preview-close"
            data-preview-close
            aria-label="Close website preview"
          >
            ×
          </button>
        </div>
      </header>
      <div class="portfolio-preview-frame-shell">
        <img
          class="portfolio-preview-image"
          src={pipePatchPreview.src}
          alt="Website preview"
          width="1200"
          height="675"
        />
        <iframe
          class="portfolio-preview-frame"
          title="Interactive website preview"
          src="about:blank"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>
  </div>
</article>

<script>
  const portfolioCounter = document.querySelector('[data-portfolio-counter]');

  if (portfolioCounter instanceof HTMLElement) {
    const target = Number(portfolioCounter.dataset.target || 52);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hasCounted = false;

    const setCounterValue = (value: number) => {
      portfolioCounter.textContent = `${String(value).padStart(2, '0')}+`;
    };

    const runCounter = () => {
      if (hasCounted) return;
      hasCounted = true;

      if (reduceMotion) {
        setCounterValue(target);
        return;
      }

      const duration = 1400;
      const startTime = performance.now();
      setCounterValue(0);

      const tick = (now: number) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const easedProgress = 1 - (1 - progress) ** 3;
        setCounterValue(Math.round(target * easedProgress));
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    if ('IntersectionObserver' in window) {
      const counterObserver = new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          runCounter();
          observer.disconnect();
        },
        { threshold: 0.45 },
      );
      counterObserver.observe(portfolioCounter);
    } else {
      runCounter();
    }
  }

  const modal = document.querySelector('[data-portfolio-modal]');
  const modalImage = modal?.querySelector('.portfolio-preview-image');
  const modalFrame = modal?.querySelector('.portfolio-preview-frame');
  const modalTitle = modal?.querySelector('#portfolio-preview-title');
  const modalLink = modal?.querySelector('.portfolio-preview-live-link');
  const modeToggle = modal?.querySelector('[data-preview-mode-toggle]');
  const closeButton = modal?.querySelector('.portfolio-preview-close');
  let previousFocus: Element | null = null;
  let closeTimer: number;

  const closePreview = () => {
    if (!(modal instanceof HTMLElement)) return;
    modal.classList.remove('is-open');
    document.body.classList.remove('portfolio-preview-open');
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => {
      modal.hidden = true;
      if (modalFrame instanceof HTMLIFrameElement) modalFrame.src = 'about:blank';
      if (previousFocus instanceof HTMLElement) previousFocus.focus();
    }, 220);
  };

  modeToggle?.addEventListener('click', () => {
    if (!(modal instanceof HTMLElement) || !(modeToggle instanceof HTMLButtonElement)) return;
    const imageMode = modal.classList.toggle('is-image-mode');
    modeToggle.setAttribute('aria-pressed', String(imageMode));
    modeToggle.textContent = imageMode ? 'Live preview' : 'Image preview';
  });

  document.querySelectorAll('.portfolio-preview-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!(modal instanceof HTMLElement) || !(trigger instanceof HTMLElement)) return;
      const { previewUrl, previewTitle, previewImage } = trigger.dataset;
      if (!previewUrl || !previewTitle || !previewImage) return;
      previousFocus = trigger;
      modal.hidden = false;
      modal.classList.remove('is-image-mode');
      if (modeToggle instanceof HTMLButtonElement) {
        modeToggle.setAttribute('aria-pressed', 'false');
        modeToggle.textContent = 'Image preview';
      }
      if (modalTitle) modalTitle.textContent = previewTitle;
      if (modalLink instanceof HTMLAnchorElement) modalLink.href = previewUrl;
      if (modalFrame instanceof HTMLIFrameElement) {
        modalFrame.src = previewUrl;
        modalFrame.title = `${previewTitle} interactive website preview`;
      }
      if (modalImage instanceof HTMLImageElement) {
        modalImage.src = previewImage;
        modalImage.alt = `${previewTitle} website preview`;
      }
      document.body.classList.add('portfolio-preview-open');
      requestAnimationFrame(() => modal.classList.add('is-open'));
      if (closeButton instanceof HTMLElement) closeButton.focus();
    });
  });

  modal
    ?.querySelectorAll('[data-preview-close]')
    .forEach((control) => control.addEventListener('click', closePreview));

  document.querySelectorAll('[data-portfolio-filter]').forEach((filter) => {
    filter.addEventListener('click', () => {
      if (!(filter instanceof HTMLButtonElement)) return;
      const selected = filter.dataset.portfolioFilter;
      document.querySelectorAll('[data-portfolio-filter]').forEach((button) => {
        const active = button === filter;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      let visible = 0;
      document.querySelectorAll('[data-project-category]').forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const show = selected === 'all' || card.dataset.projectCategory === selected;
        card.hidden = !show;
        if (show) visible += 1;
      });
      const empty = document.querySelector('[data-portfolio-empty]');
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.classList.contains('is-open')) closePreview();
  });
</script>
