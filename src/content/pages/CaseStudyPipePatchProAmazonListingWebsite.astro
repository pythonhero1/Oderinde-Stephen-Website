---
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
---

<div class="page-layout page-content">
  <div class="section-stack">
    <PageSection class="section-1-project page-section flex-section">
      <Container class="row-1-project container flex-row">
        <Column class="column-1-project column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <TextBlock class="copy-1-project copy-block tone-light block flex-block">
            <p>CASE STUDY • WORDPRESS • PRODUCT COMMERCE</p>
          </TextBlock>
          <Heading class="heading-1-project block flex-block" level={1}>
            Pipe Patch Pro WordPress <span style="color: #0EA5A8;">Product Website</span>{' '}
            Development
          </Heading>
          <TextBlock class="copy-2-project copy-block tone-light block flex-block">
            <p>
              I developed a standalone WordPress product website for Pipe Patch Pro to showcase
              three emergency pipe-repair kits, explain their features and provide clear Amazon
              purchasing options, supported by WooCommerce infrastructure.
            </p>
          </TextBlock>
          <div class="group-1-project last-column block flex-group blend-normal">
            <ButtonLink
              wrapperClass="block button-wrap button-1-project-wrapper"
              class="button-1-project button tone-light block flex-block"
              href="https://www.pipepatchpro.net/"
            >
              Visit Live Website
            </ButtonLink>
            <ButtonLink
              wrapperClass="block button-wrap button-2-project-wrapper"
              class="button-2-project button tone-light block flex-block"
              href="/case-studies/"
            >
              All Case Studies
            </ButtonLink>
          </div>
        </Column>
        <Column class="column-2-project column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <div class="group-2-project last-column block flex-group blend-normal">
            <div class="group-3-project block flex-group blend-normal">
              <div class="group-4-project block flex-group blend-normal">
                <div class="icon-1-project icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-2-project icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
                <div class="icon-3-project icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
              <Heading class="heading-2-project block flex-block" level={4}>
                pipepatchpro.net
              </Heading>
            </div>
            <div class="group-5-project last-column block flex-group blend-normal"></div>
          </div>
        </Column>
      </Container>
      <Container class="row-2-project container flex-row">
        <Column class="column-3-project column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
          <div class="group-6-project last-column block flex-group blend-normal">
            <Heading class="heading-3-project block flex-block" level={1}>
              Product Website
            </Heading>
            <div class="icon-4-project icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
        </Column>
        <Column class="column-4-project column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
          <div class="group-7-project last-column block flex-group blend-normal">
            <Heading class="heading-4-project block flex-block" level={1}>
              WooCommerce
            </Heading>
            <div class="icon-5-project icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
        </Column>
        <Column class="column-5-project column flex-column blend-normal width-6-24 width-6-24-tablet width-12-24-phone width-6-24-wide-tablet">
          <div class="group-8-project last-column block flex-group blend-normal">
            <Heading class="heading-5-project block flex-block" level={1}>
              Amazon Integration
            </Heading>
            <div class="icon-6-project icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
        </Column>
        <Column class="column-6-project column last-column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
          <div class="group-9-project last-column block flex-group blend-normal">
            <Heading class="heading-6-project block flex-block" level={1}>
              Hostinger Setup
            </Heading>
            <div class="icon-7-project icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-1 page-section flex-section" />
    <PageSection class="section-2 page-section flex-section">
      <Container class="row-1 container flex-row">
        <Column class="column-1 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-1 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-1 block flex-block" level={4}>
            BUSINESS
          </Heading>
          <Heading class="heading-2 block flex-block" level={3}>
            Emergency Pipe Repair Kits
          </Heading>
        </Column>
        <Column class="column-2 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-2 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-3 block flex-block" level={4}>
            PLATFORM
          </Heading>
          <Heading class="heading-4 block flex-block" level={3}>
            WordPress Product Website
          </Heading>
        </Column>
        <Column class="column-3 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-3 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-5 block flex-block" level={4}>
            COMMERCE
          </Heading>
          <Heading class="heading-6 block flex-block" level={3}>
            WooCommerce
          </Heading>
        </Column>
        <Column class="column-4 column last-column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="icon-4 icon-block block flex-block">
            <span class="icon-frame">
              <span class="icon"></span>
            </span>
          </div>
          <Heading class="heading-7 block flex-block" level={4}>
            INFRASTRUCTURE
          </Heading>
          <Heading class="heading-8 block flex-block" level={3}>
            Hostinger + Business Email
          </Heading>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-3 page-section flex-section">
      <Container class="row-2 container flex-row">
        <Column class="column-5 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-9 block flex-block" level={2}>
            FROM THE PROJECT BRIEF
          </Heading>
          <Heading class="heading-10 block flex-block" level={2}>
            An independent product website that complements Amazon — instead of depending on it.
          </Heading>
          <TextBlock class="copy-1 copy-block tone-light block flex-block">
            <p>
              Pipe Patch Pro needed its own web presence for product education, support and multiple
              purchase pathways.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-3 container flex-row">
        <Column class="column-6 column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-11 block flex-block" level={4}>
            BUSINESS GOAL
          </Heading>
          <Heading class="heading-12 block flex-block" level={3}>
            Build a standalone sales and support hub around three Pipe Patch Pro repair kits.
          </Heading>
          <TextBlock class="copy-2 copy-block tone-light block flex-block">
            <p>
              The client wanted Pipe Patch Pro separated from Amazon while still giving shoppers a
              direct route to the FMP 888 storefront and a WooCommerce option for direct orders.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-7 column last-column flex-column blend-normal width-12-24 width-24-24-tablet width-24-24-phone width-12-24-wide-tablet">
          <Heading class="heading-13 block flex-block" level={4}>
            SYSTEM DELIVERED
          </Heading>
          <Heading class="heading-14 block flex-block" level={3}>
            A WordPress Product Website with a focused landing page, product presentation sections
            and clear calls to action.
          </Heading>
          <TextBlock class="copy-3 copy-block tone-light block flex-block">
            <p>
              The build included Hostinger and WordPress setup, Homeowners, Contractors and
              Facilities Maintenance kit presentation, How It Works and Build Standards content,
              FAQ, Amazon review content, business email and WooCommerce onboarding support.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-4 container flex-row">
        <Column class="column-8 column flex-column blend-normal width-10-24 width-24-24-tablet width-24-24-phone width-10-24-wide-tablet">
          <Heading class="heading-15 block flex-block" level={4}>
            PLATFORM &amp; COMMERCE
          </Heading>
          <div class="group-1 block flex-group blend-normal">
            <div class="group-2 block flex-group blend-normal">
              <div class="icon-5 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-16 block flex-block" level={4}>
                WordPress
              </Heading>
            </div>
            <div class="group-3 block flex-group blend-normal">
              <div class="icon-6 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-17 block flex-block" level={4}>
                WooCommerce
              </Heading>
            </div>
            <div class="group-4 last-column block flex-group blend-normal">
              <div class="icon-7 icon-block block flex-block">
                <span class="icon-frame">
                  <span class="icon"></span>
                </span>
              </div>
              <Heading class="heading-18 block flex-block" level={4}>
                Hostinger
              </Heading>
            </div>
          </div>
          <TextBlock class="copy-4 copy-block tone-light block flex-block">
            <p>
              Amazon storefront links and info@pipepatchpro.net completed the product purchase and
              support flow.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-9 column last-column flex-column blend-normal width-14-24 width-24-24-tablet width-24-24-phone width-14-24-wide-tablet">
          <Heading class="heading-19 block flex-block" level={4}>
            DELIVERED OUTCOME
          </Heading>
          <Heading class="heading-20 block flex-block" level={3}>
            Standalone product platform launched
          </Heading>
          <TextBlock class="copy-5 copy-block tone-light block flex-block">
            <p>
              pipepatchpro.net went live with dedicated product content, Amazon purchase links and a
              WooCommerce foundation. Direct WooCommerce payment activation remained dependent on
              the client completing banking and WooPayments onboarding.
            </p>
          </TextBlock>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-4 page-section flex-section">
      <Container class="row-5 container flex-row">
        <Column class="column-10 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-21 block flex-block" level={2}>
            DOMAIN MIGRATION &amp; MIGRATE + BUILD
          </Heading>
          <Heading class="heading-22 block flex-block" level={2}>
            The domain move from Wix delayed the build — but not the product plan.
          </Heading>
          <TextBlock class="copy-6 copy-block tone-light block flex-block">
            <p>
              pipepatchpro.net was held at Wix until transfer eligibility, then moved to Hostinger.
              Development also required access troubleshooting and two-factor authentication
              coordination before WordPress installation could move forward.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-6 container flex-row">
        <Column class="column-11 column flex-column blend-normal width-9-24 width-24-24-tablet width-24-24-phone width-9-24-wide-tablet">
          <Heading class="heading-23 block flex-block" level={4}>
            BEFORE
          </Heading>
          <Heading class="heading-24 block flex-block" level={3}>
            Amazon sales without an independent product hub
          </Heading>
          <div class="group-5 block flex-group blend-normal">
            <div class="icon-8 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-7 copy-block tone-light block flex-block">
              <p>Domain locked at Wix during transfer window</p>
            </TextBlock>
          </div>
          <div class="group-6 block flex-group blend-normal">
            <div class="icon-9 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-8 copy-block tone-light block flex-block">
              <p>No standalone WordPress product site</p>
            </TextBlock>
          </div>
          <div class="group-7 block flex-group blend-normal">
            <div class="icon-10 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-9 copy-block tone-light block flex-block">
              <p>No central customer-support inbox</p>
            </TextBlock>
          </div>
          <div class="group-8 last-column block flex-group blend-normal">
            <div class="icon-11 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-10 copy-block tone-light block flex-block">
              <p>Product content split across Amazon assets</p>
            </TextBlock>
          </div>
        </Column>
        <Column class="column-12 column flex-column blend-normal width-6-24 width-24-24-tablet width-24-24-phone width-6-24-wide-tablet">
          <div class="group-9 block flex-group blend-normal">
            <div class="icon-12 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <Heading class="heading-25 block flex-block" level={4}>
              MIGRATE + BUILD
            </Heading>
          </div>
          <TextBlock class="copy-11 copy-block tone-light block flex-block">
            <p>
              Transfer
              <br />
              Build
              <br />
              Connect
            </p>
          </TextBlock>
        </Column>
        <Column class="column-13 column last-column flex-column blend-normal width-9-24 width-24-24-tablet width-24-24-phone width-9-24-wide-tablet">
          <Heading class="heading-26 block flex-block" level={4}>
            AFTER
          </Heading>
          <Heading class="heading-27 block flex-block" level={3}>
            Launch-ready WordPress Product Website
          </Heading>
          <div class="group-10 block flex-group blend-normal">
            <div class="icon-13 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-12 copy-block tone-light block flex-block">
              <p>Domain transferred to Hostinger</p>
            </TextBlock>
          </div>
          <div class="group-11 block flex-group blend-normal">
            <div class="icon-14 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-13 copy-block tone-light block flex-block">
              <p>Three kit paths structured</p>
            </TextBlock>
          </div>
          <div class="group-12 block flex-group blend-normal">
            <div class="icon-15 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-14 copy-block tone-light block flex-block">
              <p>Amazon + WooCommerce purchase routes</p>
            </TextBlock>
          </div>
          <div class="group-13 last-column block flex-group blend-normal">
            <div class="icon-16 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
            <TextBlock class="copy-15 copy-block tone-light block flex-block">
              <p>Business support email created</p>
            </TextBlock>
          </div>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-5 page-section flex-section">
      <Container class="row-7 container flex-row">
        <Column class="column-14 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-28 block flex-block" level={2}>
            WEBSITE ARCHITECTURE
          </Heading>
          <Heading class="heading-29 block flex-block" level={2}>
            One product story, six conversion-focused sections.
          </Heading>
          <TextBlock class="copy-16 copy-block tone-light block flex-block">
            <p>
              The site was organized around the questions buyers need answered before purchase: what
              it is, how it works, which kit fits, why it is credible, where to buy and how to get
              support.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-8 container flex-row">
        <Column class="column-15 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-14 block flex-group blend-normal">
            <Heading class="heading-30 block flex-block" level={4}>
              PRODUCT
            </Heading>
            <div class="icon-17 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-17 copy-block tone-light block flex-block">
            <p>Domain transferred to Hostinger</p>
          </TextBlock>
        </Column>
        <Column class="column-16 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-15 block flex-group blend-normal">
            <Heading class="heading-31 block flex-block" level={4}>
              HOW IT WORKS
            </Heading>
            <div class="icon-18 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-18 copy-block tone-light block flex-block">
            <p>Product overview</p>
          </TextBlock>
        </Column>
        <Column class="column-17 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-16 block flex-group blend-normal">
            <Heading class="heading-32 block flex-block" level={4}>
              KITS
            </Heading>
            <div class="icon-19 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-19 copy-block tone-light block flex-block">
            <p>6 / 12 / 20 pack options</p>
          </TextBlock>
        </Column>
        <Column class="column-18 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-17 block flex-group blend-normal">
            <Heading class="heading-33 block flex-block" level={4}>
              BUILD STANDARDS
            </Heading>
            <div class="icon-20 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-20 copy-block tone-light block flex-block">
            <p>150 PSI + 304 stainless steel</p>
          </TextBlock>
        </Column>
        <Column class="column-19 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-18 block flex-group blend-normal">
            <Heading class="heading-34 block flex-block" level={4}>
              REVIEWS
            </Heading>
            <div class="icon-21 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-21 copy-block tone-light block flex-block">
            <p>Amazon customer proof</p>
          </TextBlock>
        </Column>
        <Column class="column-20 column last-column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <div class="group-19 block flex-group blend-normal">
            <Heading class="heading-35 block flex-block" level={4}>
              SUPPORT
            </Heading>
            <div class="icon-22 icon-block block flex-block">
              <span class="icon-frame">
                <span class="icon"></span>
              </span>
            </div>
          </div>
          <TextBlock class="copy-22 copy-block tone-light block flex-block">
            <p>FAQ + business email</p>
          </TextBlock>
        </Column>
      </Container>
    </PageSection>
    <PageSection class="section-6 page-section flex-section">
      <Container class="row-9 container flex-row">
        <Column class="column-21 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
          <Heading class="heading-36 block flex-block" level={2}>
            PRODUCT RANGE
          </Heading>
          <Heading class="heading-37 block flex-block" level={2}>
            Three kits for three different maintenance needs.
          </Heading>
          <TextBlock class="copy-23 copy-block tone-light block flex-block">
            <p>
              The final website distinguishes the product by user type and repair quantity, using
              the client-approved kit names, pricing and use cases.
            </p>
          </TextBlock>
        </Column>
      </Container>
      <Container class="row-10 container flex-row">
        <Column class="column-22 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <Heading class="heading-38 block flex-block" level={3}>
            HOW IT WORKS
          </Heading>
          <Heading class="heading-39 block flex-block" level={4}>
            HOMEOWNERS
          </Heading>
          <TextBlock class="copy-24 copy-block tone-light block flex-block">
            <p>
              6 PACK · $16.99 · Common household pipes from 1/4&quot; to 3/4&quot;, hot or cold
              water, indoors or outside.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-23 column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <Heading class="heading-40 block flex-block" level={3}>
            ↔
          </Heading>
          <Heading class="heading-41 block flex-block" level={4}>
            CONTRACTORS
          </Heading>
          <TextBlock class="copy-25 copy-block tone-light block flex-block">
            <p>
              12 PACK · $21.99 · Plumbers, handyman services and property managers · 12 repairs.
            </p>
          </TextBlock>
        </Column>
        <Column class="column-24 column last-column flex-column blend-normal width-8-24 width-24-24-tablet width-24-24-phone width-8-24-wide-tablet">
          <Heading class="heading-42 block flex-block" level={3}>
            20 PACK
          </Heading>
          <Heading class="heading-43 block flex-block" level={4}>
            FACILITIES
          </Heading>
          <TextBlock class="copy-26 copy-block tone-light block flex-block">
            <p>
              20 PACK · $24.95 · Healthcare facilities, schools, office buildings and apartment
              complexes · 20 repairs.
