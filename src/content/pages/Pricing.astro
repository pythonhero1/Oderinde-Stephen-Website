                  <ResponsiveImage
                    source="Flow-Arrow.svg"
                    title="Flow Arrow"
                    width="32"
                    height="18"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <div class="group-10 last-column block flex-group blend-normal os-motion-lift">
                <div class="group-11 block flex-group blend-normal">
                  <ImageBlock class="image-6 image-block block flex-block">
                    <span class="image-frame">
                      <ResponsiveImage
                        source="TESTING-HANDOVER-—-Icon.svg"
                        title="TESTING &amp; HANDOVER — Icon"
                        width="84"
                        height="84"
                        sizes="96px"
                      />
                    </span>
                  </ImageBlock>
                  <Heading class="heading-22 block flex-block" level={1}>
                    03
                  </Heading>
                </div>
                <Heading class="heading-23 block flex-block" level={5}>
                  Testing &amp; Project Handover
                </Heading>
                <TextBlock class="copy-34 copy-block tone-light block flex-block">
                  <p>
                    Confirm the applicable responsive checks, functionality testing, final
                    deliverables and handover arrangements.
                  </p>
                </TextBlock>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-4 page-section flex-section">
          <Container class="row-9 container flex-row">
            <Column class="column-17 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-35 copy-block tone-light block flex-block">
