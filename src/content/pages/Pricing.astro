---
import site from '../../config/site.json';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
import ImageBlock from '../../components/content/ImageBlock.astro';
import ResponsiveImage from '../../components/content/ResponsiveImage.astro';
import Accordion from '../../components/content/Accordion.astro';
---

<article id="page-entry">
  <div class="entry-content">
    <div class="page-layout page-content">
      <div class="section-stack">
        <PageSection class="section-1 page-section flex-section">
          <Container class="row-1 container flex-row">
            <Column class="column-1 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-1 copy-block tone-light block flex-block">
                <p>SERVICES &amp; PRICING</p>
              </TextBlock>
              <Heading class="heading-1 block flex-block" level={1}>
                Clear <span style="color: #3B82F6;">Starting Prices.</span> Solutions Built Around
                Your Goals.
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  Explore clear starting prices for professional website development, Shopify and
                  WooCommerce stores, website redesigns and custom digital solutions. Every project
                  is quoted based on your goals, requirements and the work involved.
                </p>
              </TextBlock>
              <div class="group-1 last-column block flex-group blend-normal">
                <ButtonLink
                  wrapperClass="block button-wrap button-1-wrapper"
                  class="button-1 button tone-light block flex-block"
                  href="/pricing/#packages"
                >
                  Explore Packages
                </ButtonLink>
                <ButtonLink
                  wrapperClass="block button-wrap button-2-wrapper"
                  class="button-2 button tone-light block flex-block"
                  href="/case-studies/"
                >
                  Request a Quote
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-2 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <ImageBlock class="image-1 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="Split-Color-PRICING-Chalkboard.avif"
                    alt="Website development pricing and service packages"
                    title="Split-Color PRICING Chalkboard"
                    width="1448"
                    height="1086"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    priority
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-2 container flex-row">
            <Column class="column-3 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-2 last-column block flex-group blend-normal">
                <Heading class="heading-2 block flex-block" level={1}>
                  Business-first thinking
                </Heading>
                <div class="icon-1 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-4 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-3 last-column block flex-group blend-normal">
                <Heading class="heading-3 block flex-block" level={1}>
                  Responsive development
                </Heading>
                <div class="icon-2 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-5 column flex-column blend-normal width-6-24 width-6-24-tablet width-12-24-phone width-6-24-wide-tablet">
              <div class="group-4 last-column block flex-group blend-normal">
                <Heading class="heading-4 block flex-block" level={1}>
                  Clear project communication
                </Heading>
                <div class="icon-3 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-5 last-column block flex-group blend-normal">
                <Heading class="heading-5 block flex-block" level={1}>
                  Built around your goals
                </Heading>
                <div class="icon-4 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-2 page-section flex-section">
          <Container class="row-3 container flex-row">
            <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-12-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-3 copy-block tone-light block flex-block">
                <p>STARTING-PRICE PACKAGES</p>
              </TextBlock>
              <Heading id="packages" class="heading-6 block flex-block" level={2}>
                Website &amp; Digital Solutions <span style="color: #3B82F6;">Pricing.</span>
              </Heading>
              <TextBlock class="copy-4 copy-block tone-light block flex-block">
                <p>
                  Four service categories, transparent minimum prices and room to tailor the scope.
                  The final quotation depends on your requirements.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-4 container flex-row">
            <Column class="column-8 column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-5 copy-block tone-light block flex-block">
                <p>BUSINESS WEBSITE</p>
              </TextBlock>
              <Heading class="heading-7 block flex-block" level={3}>
                Business Website Development
              </Heading>
              <TextBlock class="copy-6 copy-block tone-light block flex-block">
                <p>
                  For service businesses seeking a professional website that clearly presents their
                  offer and encourages enquiries.
                </p>
              </TextBlock>
              <TextBlock class="copy-7 copy-block tone-light block flex-block">
                <p>STARTING FROM</p>
              </TextBlock>
              <Heading class="heading-8 block flex-block" level={3}>
                £450
              </Heading>
              <ButtonLink
                wrapperClass="block button-wrap button-3-wrapper"
                class="button-3 button tone-light block flex-block"
                href="/contact/"
              >
                Discuss Your Project
              </ButtonLink>
              <TextBlock class="copy-8 copy-block tone-light block flex-block">
                <p>SCOPE CONSIDERATIONS</p>
              </TextBlock>
              <ul class="layout-icon-list-0 layout-icon-list block flex-block">
                <li class="layout-icon-list-item-0 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Site structure and design direction</div>
                </li>
                <li class="layout-icon-list-item-1 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Responsive page experience</div>
                </li>
                <li class="layout-icon-list-item-2 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Contact and lead generation planning</div>
                </li>
                <li class="layout-icon-list-item-3 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Content and SEO foundations</div>
                </li>
              </ul>
              <TextBlock class="copy-9 copy-block tone-light block flex-block">
                <p>
                  Illustrative scope considerations; not guaranteed inclusions at this starting
                  price.
                </p>
              </TextBlock>
            </Column>
            <Column class="column-9 column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-10 copy-block tone-light block flex-block">
                <p>ONLINE STORE</p>
              </TextBlock>
              <Heading class="heading-9 block flex-block" level={3}>
                E-commerce Development
              </Heading>
              <TextBlock class="copy-11 copy-block tone-light block flex-block">
                <p>
                  For Shopify or WooCommerce projects requiring a practical, customer-focused store
                  experience.
                </p>
              </TextBlock>
              <TextBlock class="copy-12 copy-block tone-light block flex-block">
                <p>STARTING FROM</p>
              </TextBlock>
              <Heading class="heading-10 block flex-block" level={3}>
                £250
              </Heading>
              <ButtonLink
                wrapperClass="block button-wrap button-4-wrapper"
                class="button-4 button tone-light block flex-block"
                href="/contact/"
              >
                Discuss Your Project
              </ButtonLink>
              <TextBlock class="copy-13 copy-block tone-light block flex-block">
                <p>SCOPE CONSIDERATIONS</p>
              </TextBlock>
              <ul class="layout-icon-list-1 layout-icon-list block flex-block">
                <li class="layout-icon-list-item-4 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Shopify or WooCommerce requirements</div>
                </li>
                <li class="layout-icon-list-item-5 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Product and collection presentation</div>
                </li>
                <li class="layout-icon-list-item-6 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Cart, checkout and payment planning</div>
                </li>
                <li class="layout-icon-list-item-7 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Shipping and store operations</div>
                </li>
              </ul>
              <TextBlock class="copy-14 copy-block tone-light block flex-block">
                <p>
                  Illustrative scope considerations; not guaranteed inclusions at this starting
                  price.
                </p>
              </TextBlock>
            </Column>
            <Column class="column-10 column last-column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-15 copy-block tone-light block flex-block">
                <p>EXISTING WEBSITE</p>
              </TextBlock>
              <Heading class="heading-11 block flex-block" level={3}>
                Website Redesign
              </Heading>
              <TextBlock class="copy-16 copy-block tone-light block flex-block">
                <p>
                  For established websites that need a more polished design and clearer visitor
                  journeys.
                </p>
              </TextBlock>
              <TextBlock class="copy-17 copy-block tone-light block flex-block">
                <p>STARTING FROM</p>
              </TextBlock>
              <Heading class="heading-12 block flex-block" level={3}>
                £400
              </Heading>
              <ButtonLink
                wrapperClass="block button-wrap button-5-wrapper"
                class="button-5 button tone-light block flex-block"
                href="/contact/"
              >
                Discuss Your Project
              </ButtonLink>
              <TextBlock class="copy-18 copy-block tone-light block flex-block">
                <p>SCOPE CONSIDERATIONS</p>
              </TextBlock>
              <ul class="layout-icon-list-2 layout-icon-list block flex-block">
                <li class="layout-icon-list-item-8 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Existing website review</div>
                </li>
                <li class="layout-icon-list-item-9 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Visual and responsive improvements</div>
                </li>
                <li class="layout-icon-list-item-10 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Navigation and calls to action</div>
                </li>
                <li class="layout-icon-list-item-11 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Content preservation and migration review</div>
                </li>
              </ul>
              <TextBlock class="copy-19 copy-block tone-light block flex-block">
                <p>
                  Illustrative scope considerations; not guaranteed inclusions at this starting
                  price.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-5 container flex-row">
            <Column class="column-11 column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-20 copy-block tone-light block flex-block">
                <p>CUSTOM SYSTEMS</p>
              </TextBlock>
              <Heading class="heading-13 block flex-block" level={3}>
                Digital Solutions &amp; Automation
              </Heading>
              <TextBlock class="copy-21 copy-block tone-light block flex-block">
                <p>
                  For tailored integrations and workflows that reduce manual tasks and support
                  business operations.
                </p>
              </TextBlock>
              <TextBlock class="copy-22 copy-block tone-light block flex-block">
                <p>STARTING FROM</p>
              </TextBlock>
              <Heading class="heading-14 block flex-block" level={3}>
                £700
              </Heading>
              <ButtonLink
                wrapperClass="block button-wrap button-6-wrapper"
                class="button-6 button tone-light block flex-block"
                href="/contact/"
              >
                Discuss Your Project
              </ButtonLink>
              <TextBlock class="copy-23 copy-block tone-light block flex-block">
                <p>SCOPE CONSIDERATIONS</p>
              </TextBlock>
              <ul class="layout-icon-list-3 layout-icon-list block flex-block">
                <li class="layout-icon-list-item-12 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Workflow and requirements review</div>
                </li>
                <li class="layout-icon-list-item-13 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Integration and automation planning</div>
                </li>
                <li class="layout-icon-list-item-14 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Custom functionality scoping</div>
                </li>
                <li class="layout-icon-list-item-15 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Testing and handover planning</div>
                </li>
              </ul>
              <TextBlock class="copy-24 copy-block tone-light block flex-block">
                <p>
                  Illustrative scope considerations; not guaranteed inclusions at this starting
                  price.
                </p>
              </TextBlock>
            </Column>
            <Column class="column-12 column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-25 copy-block tone-light block flex-block">
                <p>NOT SURE WHICH SERVICE FITS?</p>
              </TextBlock>
              <Heading class="heading-15 block flex-block" level={3}>
                Let’s find the right approach.
              </Heading>
              <TextBlock class="copy-26 copy-block tone-light block flex-block">
                <p>
                  Tell me what you want to build, your current challenges and your priorities. I’ll
                  help define a suitable scope before providing a quote.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-7-wrapper"
                class="button-7 button tone-light block flex-block"
                href="/contact/"
              >
                Request a Quote
              </ButtonLink>
            </Column>
            <Column class="column-13 column last-column flex-column blend-normal width-8-24 width-12-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <TextBlock class="copy-27 copy-block tone-light block flex-block">
                <p>NEED SOMETHING DIFFERENT?</p>
              </TextBlock>
              <Heading class="heading-16 block flex-block" level={3}>
                Additional services
              </Heading>
              <TextBlock class="copy-28 copy-block tone-light block flex-block">
                <p>
                  Website maintenance, integrations, technical improvements and other project
                  requirements can be discussed separately.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-8-wrapper"
                class="button-8 button tone-light block flex-block"
                target="_blank"
                href={site.booking}
                rel="noopener noreferrer"
              >
                Book a Strategy Call
              </ButtonLink>
            </Column>
          </Container>
          <Container class="row-6 container flex-row">
            <Column class="column-14 column last-column flex-column blend-normal width-24-24 width-12-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-29 copy-block tone-light block flex-block">
                <p>
                  All amounts shown in GBP (£). Starting prices are indicative. Final pricing,
                  deliverables and timelines are confirmed in a written project quotation.
                </p>
              </TextBlock>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-3 page-section flex-section">
          <Container class="row-7 container flex-row">
            <Column class="column-15 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-30 copy-block tone-light block flex-block">
                <p>SCOPE BEFORE COMMITMENT</p>
              </TextBlock>
              <Heading class="heading-17 block flex-block" level={2}>
                Know Exactly What Your <span style="color: #3B82F6;">Project Includes.</span>
              </Heading>
              <TextBlock class="copy-31 copy-block tone-light block flex-block">
                <p>
                  Before development begins, your proposal outlines the agreed project scope,
                  deliverables, milestones and requirements. Whether you're planning a business
                  website, online store or custom digital solution, you'll understand what's
                  included and what may require a separate quotation.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-8 container flex-row">
            <Column class="column-16 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <div class="group-6 block flex-group blend-normal os-motion-lift">
                <div class="group-7 block flex-group blend-normal">
                  <ImageBlock class="image-2 image-block block flex-block">
                    <span class="image-frame">
                      <ResponsiveImage
                        source="DEFINED-DELIVERABLES-—-Icon.svg"
                        title="DEFINED DELIVERABLES — Icon"
                        width="84"
                        height="84"
                        sizes="96px"
                      />
                    </span>
                  </ImageBlock>
                  <Heading class="heading-18 block flex-block" level={1}>
                    01
                  </Heading>
                </div>
                <Heading class="heading-19 block flex-block" level={5}>
                  Defined Project Deliverables
                </Heading>
                <TextBlock class="copy-32 copy-block tone-light block flex-block">
                  <p>
                    Clearly identify the pages, features, integrations and other agreed components
                    included in your project quotation.
                  </p>
                </TextBlock>
              </div>
              <ImageBlock class="image-3 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="Flow-Arrow.svg"
                    title="Flow Arrow"
                    width="32"
                    height="18"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <div class="group-8 block flex-group blend-normal os-motion-lift">
                <div class="group-9 block flex-group blend-normal">
                  <ImageBlock class="image-4 image-block block flex-block">
                    <span class="image-frame">
                      <ResponsiveImage
                        source="MILESTONES-TIMELINES-—-Icon.svg"
                        title="MILESTONES &amp; TIMELINES — Icon"
                        width="84"
                        height="84"
                        sizes="96px"
                      />
                    </span>
                  </ImageBlock>
                  <Heading class="heading-20 block flex-block" level={1}>
                    02
                  </Heading>
                </div>
                <Heading class="heading-21 block flex-block" level={5}>
                  Clear Milestones &amp; Timelines
                </Heading>
                <TextBlock class="copy-33 copy-block tone-light block flex-block">
                  <p>
                    Establish realistic delivery stages, review points and dependencies based on
                    your project's requirements.
                  </p>
