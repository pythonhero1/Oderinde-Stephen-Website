---
import site from '../../config/site.json';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
import ImageBlock from '../../components/content/ImageBlock.astro';
import ResponsiveImage from '../../components/content/ResponsiveImage.astro';
import Accordion from '../../components/content/Accordion.astro';
---

<article id="page-entry">
  <div class="entry-content">
    <div class="page-layout page-content">
      <div class="section-stack">
        <PageSection class="section-1 page-section flex-section">
          <Container class="row-1 container flex-row">
            <Column class="column-1 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-1 copy-block tone-light block flex-block">
                <p>BUSINESS WEBSITE DEVELOPMENT</p>
              </TextBlock>
              <Heading class="heading-1 block flex-block" level={1}>
                Professional <span style="color: #3B82F6;">Business Websites </span> Built to{' '}
                <span style="color: #3B82F6;">Attract Clients.</span>
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  I design and develop professional, responsive business websites that communicate
                  your services clearly, build customer trust and turn visitor interest into
                  enquiries. Every website is tailored to your audience, business goals and
                  long-term growth.
                </p>
              </TextBlock>
              <div class="group-1 last-column block flex-group blend-normal">
                <ButtonLink
                  wrapperClass="block button-wrap button-1-wrapper"
                  class="button-1 button tone-light block flex-block"
                  href="/contact/"
                >
                  Start a Website Project
                </ButtonLink>
                <ButtonLink
                  wrapperClass="block button-wrap button-2-wrapper"
                  class="button-2 button tone-light block flex-block"
                  href="/case-studies/"
                >
                  View Selected Work
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-2 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <ImageBlock class="image-1 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="paper-cutout-hand-pressing-business-solution-like-button-scaled.avif"
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="2560"
                    height="1709"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    priority
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-2 container flex-row">
            <Column class="column-3 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-2 last-column block flex-group blend-normal">
                <Heading class="heading-2 block flex-block" level={1}>
                  Strategy-led structure
                </Heading>
                <div class="icon-1 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-4 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-3 last-column block flex-group blend-normal">
                <Heading class="heading-3 block flex-block" level={1}>
                  Responsive development
                </Heading>
                <div class="icon-2 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-5 column flex-column blend-normal width-6-24 width-6-24-tablet width-12-24-phone width-6-24-wide-tablet">
              <div class="group-4 last-column block flex-group blend-normal">
                <Heading class="heading-4 block flex-block" level={1}>
                  CMS you can manage
                </Heading>
                <div class="icon-3 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-5 last-column block flex-group blend-normal">
                <Heading class="heading-5 block flex-block" level={1}>
                  - Built for enquiries
                </Heading>
                <div class="icon-4 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-2 page-section flex-section">
          <Container class="row-3 container flex-row">
            <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-3 copy-block tone-light block flex-block">
                <p>BUSINESS WEBSITE CHALLENGES &amp; SOLUTIONS</p>
              </TextBlock>
              <Heading class="heading-6 block flex-block" level={2}>
                {' '}
                Is Your <span style="color: #3B82F6;">Business Website</span> Helping You{' '}
                <span style="color: #3B82F6;">Attract and Convert Clients?</span>
              </Heading>
              <TextBlock class="copy-4 copy-block tone-light block flex-block">
                <p>
                  If your website struggles to communicate your services, generate enquiries or
                  support business growth, professional website development can help create a
                  clearer, more effective customer experience.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-4 container flex-row">
            <Column class="column-8 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-6 block flex-group blend-normal">
                <ImageBlock class="image-2 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="Confused-businessman-laptop-scaled.avif"
                      title="Confused businessman laptop"
                      width="2560"
                      height="1693"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-7 last-column block flex-group blend-normal">
                <TextBlock class="copy-5 copy-block tone-light block flex-block">
                  <p>01</p>
                </TextBlock>
                <TextBlock class="copy-6 copy-block tone-light block flex-block">
                  <p>WEBSITE MESSAGING &amp; CLARITY</p>
                </TextBlock>
                <Heading class="heading-7 block flex-block" level={3}>
                  Visitors Don't Understand Your Services
                </Heading>
                <TextBlock class="copy-7 copy-block tone-light block flex-block">
                  <p>
                    Unclear messaging and poorly organized website content make it difficult for
                    potential customers to understand what your business offers and why they should
                    choose you.
                  </p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-3-wrapper"
                  class="button-3 button tone-light block flex-block"
                  href="/business-website-development/"
                >
                  Website usability
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-9 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-8 block flex-group blend-normal">
                <ImageBlock class="image-3 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="professionals-analyzing-data-charts-on-a-large-computer-scaled.avif"
                      title="professionals analyzing data charts on a large computer"
                      width="2560"
                      height="1707"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-9 last-column block flex-group blend-normal">
                <TextBlock class="copy-8 copy-block tone-light block flex-block">
                  <p>02</p>
                </TextBlock>
                <TextBlock class="copy-9 copy-block tone-light block flex-block">
                  <p>LEAD GENERATION &amp; CONVERSION</p>
                </TextBlock>
                <Heading class="heading-8 block flex-block" level={3}>
                  Your Website Isn't Generating Enough Enquiries
                </Heading>
                <TextBlock class="copy-10 copy-block tone-light block flex-block">
                  <p>
                    A visually attractive website may still struggle to generate leads when its
                    calls to action, trust signals and customer journey aren't aligned with visitor
                    needs.
                  </p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-4-wrapper"
                  class="button-4 button tone-light block flex-block"
                  href="/contact/"
                >
                  Conversion rate
                </ButtonLink>
              </div>
            </Column>
          </Container>
          <Container class="row-5 container flex-row">
            <Column class="column-10 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-10 block flex-group blend-normal">
                <ImageBlock class="image-4 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="A-developer-or-business-owner-working-with-a-CMS-dashboard-editing-pages-or-managing-website-content-scaled.avif"
                      title="A developer or business owner working with a CMS dashboard, editing pages or managing website content."
                      width="2560"
                      height="1707"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-11 last-column block flex-group blend-normal">
                <TextBlock class="copy-11 copy-block tone-light block flex-block">
                  <p>03</p>
                </TextBlock>
                <TextBlock class="copy-12 copy-block tone-light block flex-block">
                  <p>WEBSITE MANAGEMENT &amp; SCALABILITY</p>
                </TextBlock>
                <Heading class="heading-9 block flex-block" level={3}>
                  Visitors Don't Understand Your Services
                </Heading>
                <TextBlock class="copy-13 copy-block tone-light block flex-block">
                  <p>
                    An inflexible content management system can make updating pages, publishing
                    content and adding new services unnecessarily complicated as your business
                    grows.
                  </p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-5-wrapper"
                  class="button-5 button tone-light block flex-block"
                  href="/contact/"
                >
                  Website development
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-11 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-12 block flex-group blend-normal">
                <ImageBlock class="image-5 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="A-premium-modern-business-website-presented-across-desktop-and-mobile-devices-demonstrating-clarity-professionalism-and-responsive-design-scaled.avif"
                      title="A premium, modern business website presented across desktop and mobile devices, demonstrating clarity, professionalism, and responsive design."
                      width="2560"
                      height="1707"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-13 last-column block flex-group blend-normal">
                <TextBlock class="copy-14 copy-block tone-light block flex-block">
                  <p>04</p>
                </TextBlock>
                <TextBlock class="copy-15 copy-block tone-light block flex-block">
                  <p>USER EXPERIENCE &amp; BUSINESS GROWTH</p>
                </TextBlock>
                <Heading class="heading-10 block flex-block" level={3}>
                  A Website Built to Inform, Build Trust and Convert
                </Heading>
                <TextBlock class="copy-16 copy-block tone-light block flex-block">
                  <p>
                    A well-structured business website combines clear messaging, intuitive
                    navigation, responsive design and effective conversion paths to support customer
                    enquiries and long-term growth.
                  </p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-6-wrapper"
                  class="button-6 button tone-light block flex-block"
                  href="/contact/"
                >
                  Business website
                </ButtonLink>
              </div>
            </Column>
          </Container>
          <Container class="row-6 container flex-row">
            <Column class="column-12 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <div class="group-14 last-column block flex-group blend-normal">
                <ImageBlock class="image-6 image-block width-8-24 block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="CASE-STUDIES-—-Icon.svg"
                      title="CASE STUDIES — Icon"
                      width="84"
                      height="84"
                      sizes="96px"
                    />
                  </span>
                </ImageBlock>
                <TextBlock class="copy-17 copy-block tone-light block flex-block">
                  <p>
                    A professional website is one part of a successful digital presence. I also
                    build connected digital solutions that help businesses attract customers,
                    streamline operations and support long-term growth.
                  </p>
                  <p>
                    <a title="Oderinde Stephen Web &amp; Digital Solutions" href="/">
                      <strong>Explore My Digital Solutions</strong>
                    </a>
                  </p>
                </TextBlock>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-3 page-section flex-section">
          <Container class="row-7 container flex-row">
            <Column class="column-13 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-18 copy-block tone-light block flex-block">
                <p>SELECTED BUSINESS WEBSITE PROJECTS</p>
              </TextBlock>
              <Heading class="heading-11 block flex-block" level={2}>
                {' '}
                Real <span style="color: #3B82F6;">Business Website Projects</span> Built for
                Different Business Goals.
              </Heading>
              <TextBlock class="copy-19 copy-block tone-light block flex-block">
                <p>
                  Explore selected business website development projects across different
                  industries. Each example highlights how website structure, professional design and
                  tailored functionality can support a business's specific needs.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-8 container flex-row">
            <Column class="column-14 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-7 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="pipe-patch-pro-product-website-case-study-feature-image-1024x576.avif"
                    alt="Pipe Patch Pro WordPress product website showcasing emergency pipe repair kits and product information."
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <Heading class="heading-12 block flex-block" level={3}>
                Pipe Patch Pro WordPress Product Website Development
              </Heading>
              <TextBlock class="copy-20 copy-block tone-light block flex-block">
                <p>
                  A WordPress product website featuring three pipe-repair kits, Amazon purchase
                  links and WooCommerce infrastructure.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-7-wrapper"
                class="button-7 button tone-light block flex-block"
                href="/case-studies/"
              >
                View Selected Work
              </ButtonLink>
            </Column>
            <Column class="column-15 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-8 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="samuel-edmondstone-homeless-trilogy-website-website-1024x576.avif"
                    alt="Samuel Edmondstone Homeless Trilogy WordPress website homepage showcasing the mission-driven project, book presentation and storytelling content."
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <Heading class="heading-13 block flex-block" level={3}>
                Doug Steinman building a launch-ready author website for Samuel Edmond Stone
              </Heading>
              <TextBlock class="copy-21 copy-block tone-light block flex-block">
                <p>
                  Doug needed help creating an online presence for the Samuel Edmondstone / Homeless
                  Trilogy project. The work started around improving the website experience and
                  later expanded into helping establish supporting social media presence.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-8-wrapper"
                class="button-8 button tone-light block flex-block"
                href="/case-studies/"
              >
                View Selected Work
              </ButtonLink>
            </Column>
            <Column class="column-16 column last-column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-9 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="einbruchschutz-baumgaertner-website-security-homepage-1024x512.avif"
                    alt="Einbruchschutz Baumgaertner WordPress homepage showing alarm and video surveillance services, retained red branding, service calls to action and the branded security van."
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="1024"
                    height="512"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <Heading class="heading-14 block flex-block" level={3}>
                Einbruchschutz Baumgaertner modernizing an 11-page security site while protecting
                what already worked
              </Heading>
              <TextBlock class="copy-22 copy-block tone-light block flex-block">
                <p>
                  A larger repeat-client WordPress engagement covering visual redesign, responsive
                  rebuilding, on-page SEO, video, manufacturer proof, Google reviews, staging and
                  production migration for a German security business.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-9-wrapper"
                class="button-9 button tone-light block flex-block"
                href="/case-studies/"
              >
                View Selected Work
              </ButtonLink>
            </Column>
          </Container>
          <Container class="row-9 container flex-row">
            <Column class="column-17 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <ButtonLink
                wrapperClass="block button-wrap button-10-wrapper"
                class="button-10 button tone-light block flex-block"
                href="/case-studies/"
              >
                View Full Portfolio
              </ButtonLink>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-4 page-section flex-section">
          <Container class="row-10 container flex-row">
            <Column class="column-18 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-23 copy-block tone-light block flex-block">
                <p>WHAT YOUR BUSINESS WEBSITE INCLUDES</p>
              </TextBlock>
              <Heading class="heading-15 block flex-block" level={2}>
                {' '}
                What Goes Into a <span style="color: #3B82F6;">
                  Professional Business Website
                </span>{' '}
                That Works?
              </Heading>
              <TextBlock class="copy-24 copy-block tone-light block flex-block">
                <p>
                  A successful business website needs more than an attractive design. I combine
                  clear service messaging, SEO-friendly content structure, conversion-focused user
                  journeys and a manageable content management system to create websites that
                  support your business goals.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-11 container flex-row">
            <Column class="column-19 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-25 copy-block tone-light block flex-block">
                <p>01 · WEBSITE MESSAGING &amp; POSITIONING</p>
              </TextBlock>
              <Heading class="heading-16 block flex-block" level={3}>
                Communicate Your Services Clearly
              </Heading>
              <TextBlock class="copy-26 copy-block tone-light block flex-block">
                <p>
                  Clear headlines, service descriptions and calls to action help potential customers
                  understand what your business offers, who you serve and why they should choose
                  you.
                </p>
              </TextBlock>
              <ImageBlock class="image-10 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="website-messaging-border-removed.avif"
                    title="website messaging border removed"
                    width="1672"
                    height="941"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-20 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-27 copy-block tone-light block flex-block">
                <p>02 · SEO &amp; WEBSITE CONTENT STRUCTURE</p>
              </TextBlock>
              <Heading class="heading-17 block flex-block" level={3}>
                Organize Content for Search and Discovery
              </Heading>
              <TextBlock class="copy-28 copy-block tone-light block flex-block">
                <p>
                  A logical sitemap, well-structured service pages, clear headings and contextual
                  internal links help visitors and search engines understand your website.
                </p>
              </TextBlock>
              <ImageBlock class="image-11 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="website-content-structure-border-removed.avif"
                    title="website content structure border removed"
                    width="1672"
                    height="941"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-12 container flex-row">
            <Column class="column-21 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-29 copy-block tone-light block flex-block">
                <p>03 · LEAD GENERATION &amp; CONVERSION</p>
              </TextBlock>
              <Heading class="heading-18 block flex-block" level={3}>
                Guide Visitors Toward Enquiries
              </Heading>
              <TextBlock class="copy-30 copy-block tone-light block flex-block">
                <p>
                  Strategically placed contact forms, booking options and calls to action make it
                  easier for interested visitors to take the next step.
                </p>
              </TextBlock>
              <ImageBlock class="image-12 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="lead-generation-border-removed.avif"
                    title="lead generation border removed"
                    width="1672"
                    height="941"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-22 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-31 copy-block tone-light block flex-block">
                <p>04 · CMS &amp; WEBSITE SCALABILITY</p>
              </TextBlock>
              <Heading class="heading-19 block flex-block" level={3}>
                Keep Your Website Easy to Manage
              </Heading>
              <TextBlock class="copy-32 copy-block tone-light block flex-block">
                <p>
                  A flexible content management system, reusable layouts and organized page
                  templates make it easier to update content, publish new pages and expand your
                  website.
                </p>
              </TextBlock>
              <ImageBlock class="image-13 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="cms-scalability-border-removed.avif"
                    title="cms scalability border removed"
                    width="1672"
                    height="941"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-13 container flex-row">
            <Column class="column-23 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <div class="group-15 last-column block flex-group blend-normal">
                <ImageBlock class="image-14 image-block width-8-24 block flex-block">
                  <span class="image-frame">
