---
import ProjectCount from '../../components/site/ProjectCount.astro';
import site from '../../config/site.json';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
import ImageBlock from '../../components/content/ImageBlock.astro';
import ResponsiveImage from '../../components/content/ResponsiveImage.astro';
import Accordion from '../../components/content/Accordion.astro';
---

<article id="page-entry">
  <div class="entry-content">
    <div class="page-layout page-content">
      <div class="section-stack">
        <PageSection class="section-1 page-section flex-section">
          <Container class="row-1 container flex-row">
            <Column class="column-1 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-1 copy-block tone-light block flex-block">
                <p>CASE STUDIES &amp; CLIENT PROJECTS</p>
              </TextBlock>
              <Heading class="heading-1 block flex-block" level={1}>
                Real <span style="color: #3B82F6;">Website &amp; Digital Project Case Studies</span>{' '}
                Built Around Business Goals.
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  Explore website development, e-commerce, redesign and digital solution projects
                  from Oderinde Stephen Web &amp; Digital Solutions. Discover the business
                  challenges, technologies, development strategies and documented outcomes behind
                  each project.
                </p>
              </TextBlock>
              <div class="group-1 block flex-group blend-normal">
                <ButtonLink
                  wrapperClass="block button-wrap button-1-wrapper"
                  class="button-1 button tone-light block flex-block"
                  href="/case-studies/"
                >
                  Explore Case Studies
                </ButtonLink>
                <ButtonLink
                  wrapperClass="block button-wrap button-2-wrapper"
                  class="button-2 button tone-light block flex-block"
                  href="/case-studies/"
                >
                  View Full Portfolio
                </ButtonLink>
              </div>
              <Heading class="heading-2 block flex-block" level={1}>
                REAL PROJECT STORIES
              </Heading>
              <div class="group-2 last-column block flex-group blend-normal">
                <ProjectCount />
              </div>
            </Column>
            <Column class="column-2 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <ImageBlock class="image-1 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="case-study-on-blue-and-red-background-scaled.avif"
                    alt="Case Study signs representing Website development case studies"
                    title="case study on blue and red background"
                    width="2560"
                    height="1920"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    priority
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
          <Container class="row-2 container flex-row">
            <Column class="column-3 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-3 last-column block flex-group blend-normal">
                <Heading class="heading-3 block flex-block" level={1}>
                  Business-first strategy
                </Heading>
                <div class="icon-1 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-4 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-4 last-column block flex-group blend-normal">
                <Heading class="heading-4 block flex-block" level={1}>
                  {' '}
                  Platform-flexible builds
                </Heading>
                <div class="icon-2 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-5 column flex-column blend-normal width-6-24 width-6-24-tablet width-12-24-phone width-6-24-wide-tablet">
              <div class="group-5 last-column block flex-group blend-normal">
                <Heading class="heading-5 block flex-block" level={1}>
                  Structured client experience
                </Heading>
                <div class="icon-3 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-6 last-column block flex-group blend-normal">
                <Heading class="heading-6 block flex-block" level={1}>
                  Built for long-term growth
                </Heading>
                <div class="icon-4 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-2 page-section flex-section">
          <Container class="row-3 container flex-row">
            <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-3 copy-block tone-light block flex-block">
                <p>THE CASE STUDY LIBRARY</p>
              </TextBlock>
              <Heading class="heading-7 block flex-block" level={2}>
                {' '}
                Explore <span style="color: #3B82F6;">Website &amp; Digital Project</span> Case
                Studies.
              </Heading>
              <TextBlock class="copy-4 copy-block tone-light block flex-block">
                <p>
                  Explore real client projects covering WordPress website development, business
                  website redesign and digital solutions. Each case study explains the project's
                  objectives, challenges, technologies, development approach and documented
                  outcomes.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-4 container layout-grid-row">
            <Column class="column-8 column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-2 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="pipe-patch-pro-product-website-case-study-feature-image-1024x576.avif"
                    alt="Pipe Patch Pro WordPress product website showcasing emergency pipe repair kits and product information."
                    title="pipe patch pro product website case study feature image"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-5 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-8 block flex-block" level={1}>
                Pipe Patch Pro WordPress Product Website Development
              </Heading>
              <TextBlock class="copy-6 copy-block tone-light block flex-block">
                <p>
                  A WordPress product website featuring three pipe-repair kits, Amazon purchase
                  links and WooCommerce infrastructure.
                </p>
              </TextBlock>
              <Container class="row-5 container layout-row-nested flex-row">
                <Column class="column-9 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-9 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-10 block flex-block" level={1}>
                    WooCommerce
                  </Heading>
                  <Heading class="heading-11 block flex-block" level={1}>
                    Hostinger
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-12 block flex-block" level={1}>
                Website launched; direct WooCommerce payments pending client onboarding.
              </Heading>
              <Container class="row-6 container layout-row-nested flex-row layout-clickable">
                <Column class="column-10 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-13 block flex-block" level={1}>
                    <a
                      href="/case-study/pipe-patch-pro-amazon-listing-website/"
                      style="color:inherit"
                    >
                      View Case Study
                    </a>
                  </Heading>
                  <div class="icon-5 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
            <Column class="column-11 column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-3 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="samuel-edmondstone-homeless-trilogy-website-website-1024x576.avif"
                    alt="Samuel Edmondstone Homeless Trilogy WordPress website homepage showcasing the mission-driven project, book presentation and storytelling content."
                    title="samuel edmondstone homeless trilogy wordpress website"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-7 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-14 block flex-block" level={1}>
                Doug Steinman building a launch-ready author website for Samuel Edmond Stone
              </Heading>
              <TextBlock class="copy-8 copy-block tone-light block flex-block">
                <p>
                  Doug needed help creating an online presence for the Samuel Edmondstone / Homeless
                  Trilogy project. The work started around improving the website experience and
                  later expanded into helping establish supporting social media presence.
                </p>
              </TextBlock>
              <Container class="row-7 container layout-row-nested flex-row">
                <Column class="column-12 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-15 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-16 block flex-block" level={1}>
                    Hosting Setup
                  </Heading>
                  <Heading class="heading-17 block flex-block" level={1}>
                    Responsive Design
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-18 block flex-block" level={1}>
                The final Fiverr review gave 5/5 for Communication, 5/5 for Quality and 5/5 for
                Value. The client’s review: “I want a price to add the trilogy page and a couple
                more pages for the two new books into the website you made.
              </Heading>
              <Container class="row-8 container layout-row-nested flex-row layout-clickable">
                <Column class="column-13 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-19 block flex-block" level={1}>
                    <a href="/case-study/samuel-edmond-stone-landing-page/" style="color:inherit">
                      View Case Study
                    </a>
                  </Heading>
                  <div class="icon-6 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
            <Column class="column-14 column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-4 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="einbruchschutz-baumgaertner-website-security-homepage-1024x512.avif"
                    alt="Einbruchschutz Baumgaertner WordPress homepage showing alarm and video surveillance services, retained red branding, service calls to action and the branded security van."
                    title="einbruchschutz-baumgaertner wordpress security homepage"
                    width="1024"
                    height="512"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-9 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-20 block flex-block" level={1}>
                Einbruchschutz Baumgaertner modernizing an 11-page security site while protecting
                what already worked
              </Heading>
              <TextBlock class="copy-10 copy-block tone-light block flex-block">
                <p>
                  A larger repeat-client WordPress engagement covering visual redesign, responsive
                  rebuilding, on-page SEO, video, manufacturer proof, Google reviews, staging and
                  production migration for a German security business.
                </p>
              </TextBlock>
              <Container class="row-9 container layout-row-nested flex-row">
                <Column class="column-15 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-21 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-22 block flex-block" level={1}>
                    On-page SEO
                  </Heading>
                  <Heading class="heading-23 block flex-block" level={1}>
                    Trustindex
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-24 block flex-block" level={1}>
                The buyer returned after Bau-Helden and commissioned a significantly larger 11-page
                redesign. The client explained: “I accepted your price after seeing that the work on
                Bau-Helden matched what I needed. I hired you for another website.”
              </Heading>
              <Container class="row-10 container layout-row-nested flex-row layout-clickable">
                <Column class="column-16 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-25 block flex-block" level={1}>
                    <a
                      href="/case-study/einbruchschutz-baumgaertner-modernizing-website-redesign-case-study/"
                      style="color:inherit"
                    >
                      View Case Study
                    </a>
                  </Heading>
                  <div class="icon-7 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
            <Column class="column-17 column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-5 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="bau-helden-website-construction-homepage-1024x512.avif"
                    alt="Bau-Helden WordPress homepage for a German construction company, showing the hero section, navigation menu, service messaging and call-to-action buttons."
                    title="bau-helden wordpress construction homepage"
                    width="1024"
                    height="512"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-11 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-26 block flex-block" level={1}>
                Bau Helden turning a direct order into a structured redesign process
              </Heading>
              <TextBlock class="copy-12 copy-block tone-light block flex-block">
                <p>
                  A three-page German WordPress redesign that began without normal pre-sale
                  discovery, moved through visual planning and mobile refinement, and became the
                  design reference for the client’s next, larger engagement.
                </p>
              </TextBlock>
              <Container class="row-11 container layout-row-nested flex-row">
                <Column class="column-18 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-27 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-28 block flex-block" level={1}>
                    Elementor
                  </Heading>
                  <Heading class="heading-29 block flex-block" level={1}>
                    Responsive UX
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-30 block flex-block" level={1}>
                The strongest proof is retention. The same buyer later returned with a larger
                website and explicitly said: “I’d like a similar style to Bau-Helden you built that
                as well.&quot;
              </Heading>
              <Container class="row-12 container layout-row-nested flex-row layout-clickable">
                <Column class="column-19 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-31 block flex-block" level={1}>
                    View Case Study
                  </Heading>
                  <div class="icon-8 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
            <Column class="column-20 column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-6 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="born-accelerators-bilingual-website-homepage-de-en-1024x512.gif"
                    alt="BORN Accelerators bilingual WordPress homepage switching between German and English versions for the ISPO startup and investor campaign."
                    title="born accelerators bilingual wordpress homepage de en"
                    width="1024"
                    height="512"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-13 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-32 block flex-block" level={1}>
                BORN Accelerators building a bilingual launch platform around a moving campaign
              </Heading>
              <TextBlock class="copy-14 copy-block tone-light block flex-block">
                <p>
                  A Sport, Health &amp; Tech accelerator website built to explain a new ecosystem,
                  support German and English audiences, route startups and investors toward the
                  right action, and still launch while campaign priorities were changing.
                </p>
              </TextBlock>
              <Container class="row-13 container layout-row-nested flex-row">
                <Column class="column-21 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-33 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-34 block flex-block" level={1}>
                    Elementor
                  </Heading>
                  <Heading class="heading-35 block flex-block" level={1}>
                    Bilingual UX
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-36 block flex-block" level={1}>
                The Fiverr review recorded 5/5 Quality, 5/5 Value and 4/5 Communication. The client
                described the finished result as stable and solid after a complex bilingual launch.
              </Heading>
              <Container class="row-14 container layout-row-nested flex-row layout-clickable">
                <Column class="column-22 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-37 block flex-block" level={1}>
                    View Case Study
                  </Heading>
                  <div class="icon-9 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
            <Column class="column-23 column last-column flex-column blend-normal layout-clickable os-motion-lift">
              <ImageBlock class="image-7 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="agentur-ostwest-bilingual-website-homepage-1024x512.gif"
                    alt="Animated screen capture of the Agentur Ostwest bilingual WordPress homepage showing the agency introduction, service sections and portfolio presentation."
                    title="agentur ostwest bilingual wordpress homepage"
                    width="1024"
                    height="512"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-15 copy-block tone-light block flex-block">
                <p>CASE STUDY</p>
              </TextBlock>
              <Heading class="heading-38 block flex-block" level={1}>
                Agentur Ostwest turning an outdated agency site into a clean bilingual portfolio
              </Heading>
              <TextBlock class="copy-16 copy-block tone-light block flex-block">
                <p>
                  A focused DE/EN WordPress redesign for a German voice-over agency: simpler
                  structure, stronger portfolio presentation, clearer navigation and a content
                  workflow the client could continue managing himself.
                </p>
              </TextBlock>
              <Container class="row-15 container layout-row-nested flex-row">
                <Column class="column-24 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-39 block flex-block" level={1}>
                    WordPress
                  </Heading>
                  <Heading class="heading-40 block flex-block" level={1}>
                    Bilingual UX
                  </Heading>
                  <Heading class="heading-41 block flex-block" level={1}>
                    Responsive UX
                  </Heading>
                </Column>
              </Container>
              <Heading class="heading-42 block flex-block" level={1}>
                The final Fiverr review gave 5/5 for Communication, 5/5 for Quality and 5/5 for
                Value. The client’s review: “Perfekte Lieferung! Vielen Dank!”
              </Heading>
              <Container class="row-16 container layout-row-nested flex-row layout-clickable">
                <Column class="column-25 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
                  <Heading class="heading-43 block flex-block" level={1}>
                    View Case Study
                  </Heading>
                  <div class="icon-10 icon-block block flex-block">
                    <span class="icon-frame">
                      <span class="icon"></span>
                    </span>
                  </div>
                </Column>
              </Container>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-3 page-section flex-section">
          <Container class="row-17 container flex-row">
            <Column class="column-26 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-17 copy-block tone-light block flex-block">
                <p>SELECTED PORTFOLIO</p>
              </TextBlock>
              <Heading class="heading-44 block flex-block" level={2}>
                {' '}
                Explore My <span style="color: #3B82F6;">Selected Website Projects.</span>
              </Heading>
              <TextBlock class="copy-18 copy-block tone-light block flex-block">
                <p>
                  Explore a selection of completed business websites, product websites and redesign
                  projects. Preview the designs, visit available live websites or browse my full
                  Portfolio for more examples of my work.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-18 container flex-row">
            <Column class="column-27 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-8 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="pipe-patch-pro-product-website-case-study-feature-image-1024x576.avif"
                    alt="Pipe Patch Pro WordPress product website showcasing emergency pipe repair kits and product information."
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <TextBlock class="copy-19 copy-block tone-light block flex-block">
                <p>PORTFOLIO</p>
              </TextBlock>
              <Heading class="heading-45 block flex-block" level={3}>
                Pipe Patch Pro WordPress Product Website Development
              </Heading>
              <TextBlock class="copy-20 copy-block tone-light block flex-block">
                <p>
                  A WordPress product website featuring three pipe-repair kits, Amazon purchase
                  links and WooCommerce infrastructure.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-3-wrapper"
                class="button-3 button tone-light block flex-block"
                href="/case-study/pipe-patch-pro-amazon-listing-website/"
              >
                Vist live Website
              </ButtonLink>
            </Column>
            <Column class="column-28 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
