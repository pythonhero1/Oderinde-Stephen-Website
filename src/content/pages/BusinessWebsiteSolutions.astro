---
import site from '../../config/site.json';
import SolutionsGraphic from '../../components/content/SolutionsGraphic.astro';
import PageSection from '../../components/content/PageSection.astro';
import Container from '../../components/content/Container.astro';
import Column from '../../components/content/Column.astro';
import TextBlock from '../../components/content/TextBlock.astro';
import Heading from '../../components/content/Heading.astro';
import ButtonLink from '../../components/content/ButtonLink.astro';
import ImageBlock from '../../components/content/ImageBlock.astro';
import ResponsiveImage from '../../components/content/ResponsiveImage.astro';
import Accordion from '../../components/content/Accordion.astro';
---

<article id="page-entry" class="solutions-page">
  <div class="entry-content">
    <div class="page-layout page-content">
      <div class="section-stack">
        <PageSection class="section-1 page-section flex-section">
          <Container class="row-1 container flex-row">
            <Column class="column-1 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-1 copy-block tone-light block flex-block">
                <p>SOLUTIONS FOR BUSINESS PROBLEMS</p>
              </TextBlock>
              <Heading class="heading-1 block flex-block" level={1}>
                Start with what your business needs the website to solve.
              </Heading>
              <TextBlock class="copy-2 copy-block tone-light block flex-block">
                <p>
                  Whether you need a new website, a better online store, a strategic redesign or a
                  more connected client system, start with the business problem. I will help you
                  identify the right type of website system, then choose the technology that
                  supports it.
                </p>
              </TextBlock>
              <div class="group-1 last-column block flex-group blend-normal">
                <ButtonLink
                  wrapperClass="block button-wrap button-1-wrapper"
                  class="button-1 button tone-light block flex-block"
                  href="#solution-paths"
                >
                  Find the Right Solution
                </ButtonLink>
                <ButtonLink
                  wrapperClass="block button-wrap button-2-wrapper"
                  class="button-2 button tone-light block flex-block"
                  href="#diagnostic"
                >
                  Not Sure? Discuss Your Goal
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-2 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <SolutionsGraphic />
            </Column>
          </Container>
          <Container class="row-2 container flex-row">
            <Column class="column-3 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-2 last-column block flex-group blend-normal">
                <Heading class="heading-2 block flex-block" level={1}>
                  Business-first strategy
                </Heading>
                <div class="icon-1 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-4 column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-3 last-column block flex-group blend-normal">
                <Heading class="heading-3 block flex-block" level={1}>
                  {' '}
                  Platform-flexible builds
                </Heading>
                <div class="icon-2 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-5 column flex-column blend-normal width-6-24 width-6-24-tablet width-12-24-phone width-6-24-wide-tablet">
              <div class="group-4 last-column block flex-group blend-normal">
                <Heading class="heading-4 block flex-block" level={1}>
                  Structured client experience
                </Heading>
                <div class="icon-3 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
            <Column class="column-6 column last-column flex-column blend-normal width-6-24 width-6-24-tablet width-2-5-phone width-6-24-wide-tablet">
              <div class="group-5 last-column block flex-group blend-normal">
                <Heading class="heading-5 block flex-block" level={1}>
                  Built for long-term growth
                </Heading>
                <div class="icon-4 icon-block block flex-block">
                  <span class="icon-frame">
                    <span class="icon"></span>
                  </span>
                </div>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection id="diagnostic" class="section-2 page-section flex-section">
          <Container class="row-3 container flex-row">
            <Column class="column-7 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-3 copy-block tone-light block flex-block">
                <p>FIND THE RIGHT ROUTE</p>
              </TextBlock>
              <Heading id="solution-paths" class="heading-6 block flex-block" level={2}>
                Which situation sounds most like yours?
              </Heading>
              <TextBlock class="copy-4 copy-block tone-light block flex-block">
                <p>
                  Start with the problem you recognise. Each route takes you to a focused page
                  explaining the right solution in more detail.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-4 container flex-row">
            <Column class="column-8 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-6 block flex-group blend-normal">
                <ImageBlock class="image-2 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="BUSINESS-WEBSITE-—-Icon.svg"
                      title="business-professionals-working-at-modern-office-work"
                      width="2560"
                      height="1707"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-7 last-column block flex-group blend-normal">
                <TextBlock class="copy-5 copy-block tone-light block flex-block">
                  <p>01</p>
                </TextBlock>
                <Heading class="heading-7 block flex-block" level={3}>
                  I need a professional website for my business.
                </Heading>
                <TextBlock class="copy-6 copy-block tone-light block flex-block">
                  <p>
                    You need a website that explains the business clearly, builds credibility and
                    creates a reliable path to enquiry.
                  </p>
                </TextBlock>
                <TextBlock class="copy-7 copy-block tone-light block flex-block">
                  <p>BEST FIT - BUSINESS WEBSITE DEVELOPMENT</p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-3-wrapper"
                  class="button-3 button tone-light block flex-block"
                  href="/business-website-development/"
                >
                  Explore Business Website Development
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-9 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-8 block flex-group blend-normal">
                <ImageBlock class="image-3 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="ONLINE-STORE-—-Icon.svg"
                      title="woman selling product and man shopping for clothes together"
                      width="2560"
                      height="1707"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-9 last-column block flex-group blend-normal">
                <TextBlock class="copy-8 copy-block tone-light block flex-block">
                  <p>02</p>
                </TextBlock>
                <Heading class="heading-8 block flex-block" level={3}>
                  I want to sell products or services online.
                </Heading>
                <TextBlock class="copy-9 copy-block tone-light block flex-block">
                  <p>
                    You need an e-commerce system built around product discovery, buying decisions,
                    checkout, payments and order operations.
                  </p>
                </TextBlock>
                <TextBlock class="copy-10 copy-block tone-light block flex-block">
                  <p>BEST FIT - E-COMMERCE DEVELOPMENT</p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-4-wrapper"
                  class="button-4 button tone-light block flex-block"
                  href="/contact/"
                >
                  Explore E-commerce Development
                </ButtonLink>
              </div>
            </Column>
          </Container>
          <Container class="row-5 container flex-row">
            <Column class="column-10 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-10 block flex-group blend-normal">
                <ImageBlock class="image-4 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="WEBSITE-REDESIGN-—-Icon.svg"
                      title="frustrated businessman working on his website with compute"
                      width="2560"
                      height="1440"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-11 last-column block flex-group blend-normal">
                <TextBlock class="copy-11 copy-block tone-light block flex-block">
                  <p>03</p>
                </TextBlock>
                <Heading class="heading-9 block flex-block" level={3}>
                  I already have a website, but it is not working well.
                </Heading>
                <TextBlock class="copy-12 copy-block tone-light block flex-block">
                  <p>
                    Your current site may look outdated, communicate the wrong message, perform
                    poorly or make it difficult for visitors to take action.
                  </p>
                </TextBlock>
                <TextBlock class="copy-13 copy-block tone-light block flex-block">
                  <p>BEST FIT - WEBSITE REDESIGN</p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-5-wrapper"
                  class="button-5 button tone-light block flex-block"
                  href="/contact/"
                >
                  Explore Website Redesign
                </ButtonLink>
              </div>
            </Column>
            <Column class="column-11 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <div class="group-12 block flex-group blend-normal">
                <ImageBlock class="image-5 image-block block flex-block">
                  <span class="image-frame">
                    <ResponsiveImage
                      source="AUTOMATION-—-Icon.svg"
                      title="typing-on-laptop-displaying-online-payment-interfa-2026-01-22-23-21-01-utc"
                      width="2560"
                      height="1440"
                      sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                    />
                  </span>
                </ImageBlock>
              </div>
              <div class="group-13 last-column block flex-group blend-normal">
                <TextBlock class="copy-14 copy-block tone-light block flex-block">
                  <p>04</p>
                </TextBlock>
                <Heading class="heading-10 block flex-block" level={3}>
                  I need clients, members or students to do more online.
                </Heading>
                <TextBlock class="copy-15 copy-block tone-light block flex-block">
                  <p>
                    You may need a client portal, membership area, learning system, onboarding
                    workflow or connected business workspace.
                  </p>
                </TextBlock>
                <TextBlock class="copy-16 copy-block tone-light block flex-block">
                  <p>BEST FIT - CLIENT PORTALS &amp; BUSINESS SYSTEMS</p>
                </TextBlock>
                <ButtonLink
                  wrapperClass="block button-wrap button-6-wrapper"
                  class="button-6 button tone-light block flex-block"
                  href="/contact/"
                >
                  Explore Client Systems
                </ButtonLink>
              </div>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-3 page-section flex-section">
          <Container class="row-6 container flex-row">
            <Column class="column-12 column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <TextBlock class="copy-17 copy-block tone-light block flex-block">
                <p>NOT SURE YET?</p>
              </TextBlock>
              <Heading class="heading-11 block flex-block" level={2}>
                Not sure which solution fits your business?
              </Heading>
              <TextBlock class="copy-18 copy-block tone-light block flex-block">
                <p>
                  That is exactly what the first conversation is for. We can clarify whether you
                  need a redesign or rebuild, what the website must do, which platform is
                  appropriate and which integrations are actually necessary.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-7-wrapper"
                class="button-7 button tone-light block flex-block"
                href="/contact/"
              >
                Discuss My Project
              </ButtonLink>
            </Column>
            <Column class="column-13 column last-column flex-column blend-normal width-12-24 width-12-24-tablet width-24-24-phone width-12-24-wide-tablet">
              <Heading class="heading-12 block flex-block" level={3}>
                A strategy conversation can help clarify:
              </Heading>
              <ul class="layout-icon-list-0 layout-icon-list block flex-block">
                <li class="layout-icon-list-item-0 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Redesign vs. a completely new website</div>
                </li>
                <li class="layout-icon-list-item-1 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">Business website vs. e-commerce system</div>
                </li>
                <li class="layout-icon-list-item-2 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">
                    WordPress, WooCommerce, Shopify or another platform
                  </div>
                </li>
                <li class="layout-icon-list-item-3 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">
                    Which integrations are useful - and which are unnecessary
                  </div>
                </li>
                <li class="layout-icon-list-item-4 layout-icon-list-item block flex-block">
                  <span class="icon"></span>
                  <div class="layout-icon-list-text">
                    Which integrations are useful - and which are unnecessary
                  </div>
                </li>
              </ul>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-4 page-section flex-section">
          <Container class="row-7 container flex-row">
            <Column class="column-14 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-19 copy-block tone-light block flex-block">
                <p>PLATFORMS I BUILD WITH</p>
              </TextBlock>
              <Heading class="heading-13 block flex-block" level={2}>
                Technology comes after the business need is clear.
              </Heading>
              <TextBlock class="copy-20 copy-block tone-light block flex-block">
                <p>
                  WordPress, WooCommerce, Shopify and other platforms are selected around the
                  project, not forced onto it. The goal is the right foundation for the business now
                  and later.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-8 container flex-row">
            <Column class="column-15 column flex-column blend-normal width-6-24 width-6-24-tablet width-24-24-phone width-6-24-wide-tablet">
              <ImageBlock class="image-6 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="website-cms-platform-icon.png"
                    title="wordpress-cms-platform-icon"
                    width="1254"
                    height="1254"
                    sizes="96px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-16 column flex-column blend-normal width-6-24 width-6-24-tablet width-24-24-phone width-6-24-wide-tablet">
              <ImageBlock class="image-7 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="woocommerce-ecommerce-platform-icon.png"
                    title="woocommerce ecommerce platform icon"
                    width="1254"
                    height="1254"
                    sizes="96px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-17 column flex-column blend-normal width-6-24 width-6-24-tablet width-24-24-phone width-6-24-wide-tablet">
              <ImageBlock class="image-8 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="shopify-ecommerce-platform-icon.png"
                    title="shopify ecommerce platform icon"
                    width="1254"
                    height="1254"
                    sizes="96px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-18 column flex-column blend-normal width-6-24 width-6-24-tablet width-24-24-phone width-6-24-wide-tablet">
              <ImageBlock class="image-9 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="wix-studio-platform-icon.png"
                    title="wix studio platform icon"
                    width="1254"
                    height="1254"
                    sizes="96px"
                  />
                </span>
              </ImageBlock>
            </Column>
            <Column class="column-19 column flex-column blend-normal width-6-24 width-6-24-tablet width-24-24-phone width-6-24-wide-tablet">
              <ImageBlock class="image-10 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="framer-website-platform-icon.png"
                    title="framer website platform icon"
                    width="1254"
                    height="1254"
                    sizes="96px"
                  />
                </span>
              </ImageBlock>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-5 page-section flex-section">
          <Container class="row-9 container flex-row">
            <Column class="column-27 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-21 copy-block tone-light block flex-block">
                <p>ALREADY KNOW YOUR PLATFORM?</p>
              </TextBlock>
              <Heading class="heading-14 block flex-block" level={2}>
                Go directly to the platform-specific service.
              </Heading>
              <TextBlock class="copy-22 copy-block tone-light block flex-block">
                <p>
                  If you already know the technology you need, these pages explain the platform
                  specific development approach.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-10 container flex-row">
            <Column class="column-28 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <div class="layout-blurb tone-light block flex-block">
                <div class="layout-blurb-content flex-block">
                  <div class="layout-main-blurb-image">
                    <a href="/business-website-development/">
                      <span class="image-frame">
                        <ResponsiveImage
                          source="website-cms-platform-icon-300x300.png"
                          width="300"
                          height="300"
                          title="wordpress-cms-platform-icon"
                          sizes="96px"
                        />
                      </span>
                    </a>
                  </div>
                  <div class="layout-blurb-container">
                    <h3 class="heading-text">
                      <a href="/business-website-development/">WordPress Development</a>
                    </h3>
                    <div class="layout-blurb-description">
                      <p>
                        Flexible, content led and customised business websites that need room to
                        grow.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <ButtonLink
                wrapperClass="block button-wrap button-8-wrapper"
                class="button-8 button tone-light block flex-block"
                href="/business-website-development/"
              >
                Explore This Platform
              </ButtonLink>
            </Column>
            <Column class="column-29 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <div class="layout-blurb tone-light block flex-block">
                <div class="layout-blurb-content flex-block">
                  <div class="layout-main-blurb-image">
                    <a href="/contact/">
                      <span class="image-frame">
                        <ResponsiveImage
                          source="woocommerce-ecommerce-platform-icon-300x300.png"
                          width="300"
                          height="300"
                          title="woocommerce ecommerce platform icon"
                          sizes="96px"
                        />
                      </span>
                    </a>
                  </div>
                  <div class="layout-blurb-container">
                    <h3 class="heading-text">
                      <a href="/contact/">WooCommerce Development</a>
                    </h3>
                    <div class="layout-blurb-description">
                      <p>
                        WordPress based stores that need flexible catalogue, checkout and business
                        integrations.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <ButtonLink
                wrapperClass="block button-wrap button-9-wrapper"
                class="button-9 button tone-light block flex-block"
                href="/contact/"
              >
                Explore This Platform
              </ButtonLink>
            </Column>
            <Column class="column-30 column last-column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <div class="layout-blurb tone-light block flex-block">
                <div class="layout-blurb-content flex-block">
                  <div class="layout-main-blurb-image">
                    <a href="/contact/">
                      <span class="image-frame">
                        <ResponsiveImage
                          source="shopify-ecommerce-platform-icon-300x300.png"
                          width="300"
                          height="300"
                          title="shopify ecommerce platform icon"
                          sizes="96px"
                        />
                      </span>
                    </a>
                  </div>
                  <div class="layout-blurb-container">
                    <h3 class="heading-text">
                      <a href="/contact/">Shopify Development</a>
                    </h3>
                    <div class="layout-blurb-description">
                      <p>
                        Dedicated commerce builds for businesses that want a managed store platform
                        and streamlined operations.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <ButtonLink
                wrapperClass="block button-wrap button-10-wrapper"
                class="button-10 button tone-light block flex-block"
                href="/contact/"
              >
                Explore This Platform
              </ButtonLink>
            </Column>
          </Container>
        </PageSection>
        <PageSection class="section-6 page-section flex-section">
          <Container class="row-11 container flex-row">
            <Column class="column-31 column last-column flex-column blend-normal width-24-24 width-24-24-tablet width-24-24-phone width-24-24-wide-tablet">
              <TextBlock class="copy-23 copy-block tone-light block flex-block">
                <p>SELECTED WORK - REAL PROJECTS</p>
              </TextBlock>
              <Heading class="heading-15 block flex-block" level={2}>
                See how digital solutions become real business results.
              </Heading>
              <TextBlock class="copy-24 copy-block tone-light block flex-block">
                <p>
                  Explore selected website, e-commerce and redesign projects built around real
                  business goals. Each project shows the strategy, design decisions and digital
                  systems created to help businesses improve their online presence.
                </p>
              </TextBlock>
            </Column>
          </Container>
          <Container class="row-12 container flex-row">
            <Column class="column-32 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-18 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="pipe-patch-pro-product-website-case-study-feature-image-1024x576.avif"
                    alt="Pipe Patch Pro WordPress product website showcasing emergency pipe repair kits and product information."
                    title="paper-cutout-hand-pressing-business-solution-like-button"
                    width="1024"
                    height="576"
                    sizes="(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 640px"
                  />
                </span>
              </ImageBlock>
              <Heading class="heading-16 block flex-block" level={3}>
                Pipe Patch Pro WordPress Product Website Development
              </Heading>
              <TextBlock class="copy-25 copy-block tone-light block flex-block">
                <p>
                  A WordPress product website featuring three pipe-repair kits, Amazon purchase
                  links and WooCommerce infrastructure.
                </p>
              </TextBlock>
              <ButtonLink
                wrapperClass="block button-wrap button-11-wrapper"
                class="button-11 button tone-light block flex-block"
                href="/case-studies/"
              >
                View Selected Work
              </ButtonLink>
            </Column>
            <Column class="column-33 column flex-column blend-normal width-8-24 width-8-24-tablet width-24-24-phone width-8-24-wide-tablet">
              <ImageBlock class="image-19 image-block block flex-block">
                <span class="image-frame">
                  <ResponsiveImage
                    source="samuel-edmondstone-homeless-trilogy-website-website-1024x576.avif"
